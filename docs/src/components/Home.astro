      <div style="position:absolute;inset:0;background:linear-gradient(0deg,var(--bg) 0%,transparent 45%,rgba(0,0,0,0) 100%);pointer-events:none;"></div>
      <div style="position:relative;z-index:2;max-width:900px;margin:0 auto;padding:clamp(90px,12vw,150px) clamp(22px,5vw,64px);text-align:center;">
        <div data-reveal>
          <div class="nf-plate" style={`display:inline-flex;align-items:center;gap:11px;margin-bottom:22px;padding:8px 14px;${label}`}><span style="width:18px;height:1px;background:var(--detail);"></span>{t.download.kicker}</div>
          <h2 style="margin:0;font-size:clamp(40px,6vw,82px);line-height:1.02;letter-spacing:-.018em;font-weight:500;color:var(--ink-strong);" set:html={t.download.h2}></h2>
          <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:42px;">
            <a href={STORE_URL} data-dl="win" target="_blank" rel="noopener" class="nf-lift" style="display:inline-flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:14px;letter-spacing:.02em;color:var(--bg);background:var(--ink-strong);padding:16px 30px;border-radius:5px;box-shadow:0 12px 36px rgba(0,0,0,.32);">{t.download.windows}</a>
            <a href={RELEASES_LATEST_URL} data-dl="linux" target="_blank" rel="noopener" class="nf-ghost" style={dlGhost}>{t.download.linux}</a>
          </div>
          {/* Hidden until the client script reports the real tag_name — `visibility` (not `display`)
              so the reserved line never shifts what follows when it appears. It labels the two
              buttons above ("what you are about to download"), hence the tight margin. */}
          {/* `inline-block` so the plate hugs the line instead of spanning the whole column;
              the parent is text-align:center, so it still centres. */}
          <p data-dl-version-row class="nf-plate" style="visibility:hidden;display:inline-block;margin:16px 0 0;padding:7px 12px;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.02em;color:var(--ink-faint);">{t.download.versionLabel} <span data-dl-version></span></p>
          {/* What the Store build (the Windows button) lacks, with the GitHub installer as the way
              to get it. Footnote weight, right under the buttons it qualifies. */}
          <p class="nf-plate" style="margin:14px auto 0;max-width:496px;padding:10px 16px;font-size:14px;line-height:1.55;color:var(--ink-dim);" set:html={t.download.winStoreNote}></p>
          {/* max-width carries the horizontal padding on top of the original 460px text
              column (box-sizing is border-box site-wide), so the copy wraps exactly as before
              and only the plate is wider. */}
          <p class="nf-plate" style="margin:30px auto 0;max-width:496px;padding:12px 18px;font-size:17px;line-height:1.6;color:var(--ink-faint);" set:html={t.download.disclaimer}></p>
          {/* SmartScreen footnote for the Windows build (unsigned installer). Tinted with the
              site's amber `--detail` so it reads as a warning, but at footnote weight — it must
              not compete with the buttons or the privacy disclaimer above it. The amber rides
              on the same background scrim as `.nf-plate`, hence the nested color-mix. */}
          <div style="display:flex;gap:10px;align-items:flex-start;text-align:left;margin:22px auto 0;max-width:460px;padding:12px 14px;border:1px solid color-mix(in srgb, var(--detail) 26%, transparent);border-radius:6px;background:color-mix(in srgb, var(--detail) 6%, color-mix(in srgb, var(--bg) 76%, transparent));">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px;color:var(--detail);" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M12 8v4"></path>
              <path d="M12 16h.01"></path>
            </svg>
            <p style="margin:0;font-size:13.5px;line-height:1.55;color:var(--ink-dim);" set:html={t.download.winNote}></p>
          </div>
        </div>
        {/* Grouped footer: brand block + three link columns (Docs / Project / Legal),
            then the copyright row. Docs and legal links carry no data-nav — the synapse script
            only knows the in-page anchors. */}
        <div class="nf-footer" style="margin-top:clamp(60px,9vw,110px);padding-top:34px;border-top:1px solid var(--line);text-align:left;">
          <div class="nf-footer-grid">
            <div class="nf-footer-brand">
              <div style="display:flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--ink-dim);"><span style="width:9px;height:9px;border-radius:50%;background:var(--detail);flex:none;"></span>{t.download.footer.brand}</div>
              <p style="margin:12px 0 0;max-width:220px;font-size:14px;line-height:1.55;color:var(--ink-faint);">{t.download.footer.tagline}</p>
            </div>
            <div class="nf-footer-col">
              <div class="nf-footer-head">{t.download.footer.groups.docs}</div>
              <a href={cliHref}>{t.download.footer.cliDocs}</a>
              <a href={aiHref}>{t.download.footer.aiDocs}</a>
              <a href={featuresHref}>{t.download.footer.featuresDocs}</a>
              <a href={pricingHref}>{t.download.footer.pricingDocs}</a>
            </div>
            <div class="nf-footer-col">
              <div class="nf-footer-head">{t.download.footer.groups.project}</div>
              <a href={GITHUB} target="_blank" rel="noopener">{t.download.footer.source}</a>
              <a href={switchHref} aria-label={t.langSwitch.aria}>{t.langSwitch.label}</a>
            </div>
            <div class="nf-footer-col">
              <div class="nf-footer-head">{t.download.footer.groups.legal}</div>
              <a href={privacyHref}>{t.download.footer.privacy}</a>
              <a href={termsHref}>{t.download.footer.terms}</a>
              {legalNoticeReady && <a href={legalNoticeHref}>{t.download.footer.legalNotice}</a>}
              <a href={privacyHref} data-cookie-settings>{t.download.footer.cookies}</a>
            </div>
          </div>
          <div style="margin-top:clamp(30px,5vw,44px);padding-top:22px;border-top:1px solid var(--line);font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-faint);">{t.download.footer.copyright}</div>
        </div>
      </div>
    </footer>
  </div>

  <style is:global>
    /* ── What is NoteFlow · the clip mosaic ─────────────────────────────────── */
    /* A stage + a designer's pinboard. The stage plays one clip near its native resolution
       (1280/820 frame, ~900px wide on a 1440px screen), dead straight and lifted above the
       board; the thumbnails around it keep the loose pinboard look (inline --r/--dx/--dy tilt
       and offset, scaled by --k: 1 on desktop, softer on tablet, 0 on phones) and act as the
       selectors. Posters are CSS backgrounds (--poster-dark / --poster-light) so only the
       current theme's file loads and a theme switch needs no script. */
    .nf-anchor { position: absolute; top: 0; left: 0; width: 0; height: 0; }
    .nf-mosaic {
      --k: 1;
      --thumb-w: clamp(118px, 9.7vw, 140px);
      display: grid;
      grid-template-columns: var(--thumb-w) minmax(0, 1fr) var(--thumb-w);
      column-gap: clamp(22px, 2.2vw, 30px);
      align-items: stretch;
      margin-top: clamp(56px, 7vw, 92px);
    }
    .nf-stage { position: relative; z-index: 2; grid-column: 2; grid-row: 1; align-self: center; min-width: 0; }
    .nf-stage-glow {
      position: absolute;
      inset: -9% -7% -15%;
      background: radial-gradient(60% 60% at 50% 44%, color-mix(in srgb, var(--tone, rgb(var(--accent))) 20%, transparent), transparent 70%);
      filter: blur(34px);
      pointer-events: none;
    }
    .nf-stage-pin { position: relative; margin: 0; will-change: transform; }
    .nf-stage-card {
      position: relative;
      overflow: hidden;
      aspect-ratio: 1280 / 820;
      border: 1px solid var(--line-2);
      border-radius: 14px;
      background: var(--card-2);
      box-shadow: 0 54px 120px -34px rgba(0, 0, 0, .78), 0 18px 40px -24px rgba(0, 0, 0, .6);
    }
    [data-theme='light'] .nf-stage-card { box-shadow: 0 50px 110px -36px rgba(40, 34, 24, .5), 0 16px 36px -22px rgba(40, 34, 24, .3); }
    /* Clips of other aspects (1:1, 4:5…) are letterboxed over their own poster, blurred and
       knocked back, so the frame never changes size and never shows bare bands. */
    .nf-stage-backdrop {
      position: absolute;
      inset: -10%;
      background: var(--poster-dark) center / cover no-repeat;
      filter: blur(26px) saturate(1.15);
      opacity: .4;
    }
    [data-theme='light'] .nf-stage-backdrop { background-image: var(--poster-light); opacity: .5; }
    /* The crisp poster under the video: what shows before the first frame (and without JS). */
    .nf-stage-still { position: absolute; inset: 0; background: var(--poster-dark) center / contain no-repeat; }
    [data-theme='light'] .nf-stage-still { background-image: var(--poster-light); }
    .nf-stage-video {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .nf-stage-play {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 64px;
      height: 64px;
      margin: -32px 0 0 -32px;
      padding: 0 0 0 3px;
      color: var(--ink-strong);
      background: color-mix(in srgb, var(--card) 82%, transparent);
      border: 1px solid var(--line-2);
      border-radius: 50%;
      box-shadow: 0 14px 36px -12px rgba(0, 0, 0, .6);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      cursor: pointer;
    }
    .nf-stage-play[hidden] { display: none; }
    .nf-stage-play:hover { border-color: var(--detail); }
    .nf-stage-play:focus-visible { outline: 2px solid var(--detail); outline-offset: 3px; }
    /* Caption chip hanging off the stage's bottom-left corner, like a label pinned to a print */
    .nf-stage-chip {
      position: absolute;
      left: 18px;
      bottom: -14px;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      max-width: calc(100% - 36px);
      padding: 7px 12px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      line-height: 1.25;
      letter-spacing: .02em;
      color: var(--ink);
      background: var(--card);
      border: 1px solid var(--line-2);
      border-radius: 6px;
      box-shadow: 0 10px 22px -12px rgba(0, 0, 0, .6);
    }
    [data-theme='light'] .nf-stage-chip { box-shadow: 0 10px 22px -12px rgba(40, 34, 24, .35); }
    .nf-stage-chip::before {
      content: '';
      flex: none;
      order: 1;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--tone, var(--detail));
      box-shadow: 0 0 9px var(--tone, var(--detail));
    }
    .nf-stage-count { order: 0; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
    .nf-stage-caption { order: 2; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* Thumbnails: desktop = two columns flanking the stage, each spread over its height (4 on
       the left, 5 on the right, so the two sides interleave). The wrapper is transparent to
       the grid here and becomes a strip on smaller screens. */
    .nf-thumbs { display: contents; }
    .nf-thumbs-col {
      grid-row: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      gap: 24px;
      padding: 12px 0;
      min-width: 0;
    }
    .nf-thumbs-col.is-left { grid-column: 1; }
    .nf-thumbs-col.is-right { grid-column: 3; }
    .nf-thumb {
      position: relative;
      display: block;
      width: 100%;
      margin: 0;
      padding: 0;
      font: inherit;
      color: inherit;
      text-align: left;
      background: none;
      border: 0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .nf-thumb-pin {
      position: relative;
      display: block;
      transform:
        translate(calc(var(--dx, 0px) * var(--k)), calc(var(--dy, 0px) * var(--k)))
        rotate(calc(var(--r, 0deg) * var(--k)));
      transition: transform .45s cubic-bezier(.2, .7, .2, 1), opacity .3s ease;
    }
    .nf-thumb-card {
      position: relative;
      display: block;
      overflow: hidden;
      aspect-ratio: 16 / 10;
      border: 1px solid var(--line-2);
      border-radius: 9px;
      background: var(--card-2);
      box-shadow: 0 18px 36px -22px rgba(0, 0, 0, .7);
      transition: border-color .25s ease, box-shadow .35s ease;
    }
    [data-theme='light'] .nf-thumb-card { box-shadow: 0 18px 34px -22px rgba(40, 34, 24, .38); }
    /* Cropped from the top: the tall posters (4:5) keep the note's title and first lines */
    .nf-thumb-img { position: absolute; inset: 0; background: var(--poster-dark) center top / cover no-repeat; }
    [data-theme='light'] .nf-thumb-img { background-image: var(--poster-light); }
    /* Progress of the clip on stage, along the bottom edge of its thumbnail */
    .nf-thumb-bar {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 3px;
      background: color-mix(in srgb, var(--bg) 55%, transparent);
      opacity: 0;
      transition: opacity .25s ease;
    }
    .nf-thumb-progress {
      display: block;
      height: 100%;
      background: var(--tone, var(--detail));
      box-shadow: 0 0 8px var(--tone, var(--detail));
      transform: scaleX(0);
      transform-origin: left center;
    }
    .nf-thumb.is-active .nf-thumb-bar { opacity: 1; }
    .nf-thumb-chip {
      position: absolute;
      left: 8px;
      bottom: -10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      max-width: calc(100% + 4px);
      padding: 4px 7px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      line-height: 1.25;
      letter-spacing: .02em;
      color: var(--ink);
      background: var(--card);
      border: 1px solid var(--line-2);
      border-radius: 5px;
      box-shadow: 0 8px 18px -10px rgba(0, 0, 0, .55);
    }
    [data-theme='light'] .nf-thumb-chip { box-shadow: 0 8px 18px -10px rgba(40, 34, 24, .35); }
    .nf-thumb-chip::before {
      content: '';
      flex: none;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--tone, var(--detail));
      box-shadow: 0 0 7px var(--tone, var(--detail));
    }
    .nf-thumb-chip > span { min-width: 0; }
    /* Active: the print on stage straightens, lifts and rings in its tone; once the controller
       is running the others step back a little. */
    .nf-thumb.is-active .nf-thumb-pin {
      transform:
        translate(calc(var(--dx, 0px) * var(--k)), calc(var(--dy, 0px) * var(--k) - 4px))
        rotate(0deg) scale(1.05);
    }
    .nf-thumb.is-active .nf-thumb-card {
      border-color: var(--tone, var(--detail));
      box-shadow: 0 0 0 1px var(--tone, var(--detail)), 0 16px 34px -14px color-mix(in srgb, var(--tone, var(--detail)) 55%, transparent);
    }
    .nf-mosaic[data-ready] .nf-thumb:not(.is-active) .nf-thumb-pin { opacity: .7; }
    .nf-mosaic[data-ready] .nf-thumb:not(.is-active):focus-visible .nf-thumb-pin { opacity: 1; }
    .nf-thumb:focus-visible { outline: none; }
    .nf-thumb:focus-visible .nf-thumb-card { outline: 2px solid var(--detail); outline-offset: 3px; }
    @media (hover: hover) {
      .nf-mosaic[data-ready] .nf-thumb:not(.is-active):hover .nf-thumb-pin { opacity: 1; }
      .nf-thumb:not(.is-active):hover .nf-thumb-card { border-color: var(--detail); }
    }
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .nf-thumb:not(.is-active):hover .nf-thumb-pin {
        transform:
          translate(calc(var(--dx, 0px) * var(--k)), calc(var(--dy, 0px) * var(--k) - 3px))
          rotate(0deg) scale(1.03);
      }
    }

    /* Under the mosaic: theme switch + pause on the left, docs CTAs on the right */
    .nf-what-foot {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 14px 18px;
      margin-top: clamp(56px, 6vw, 76px);
    }
    .nf-what-controls, .nf-what-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
    .nf-what-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: .04em;
      color: var(--ink);
      background: var(--card);
      border: 1px solid var(--line-2);
      border-radius: 5px;
      padding: 12px 16px;
      cursor: pointer;
    }
    .nf-what-btn[hidden] { display: none; }
    .nf-what-btn:focus-visible { outline: 2px solid var(--detail); outline-offset: 2px; }
    .nf-what-btn .nf-ico-play { display: none; }
    .nf-what-btn[data-paused='true'] .nf-ico-play { display: block; }
    .nf-what-btn[data-paused='true'] .nf-ico-pause { display: none; }

    /* Tablet: the stage on top at full width, the thumbnails below in two staggered rows
       (5 + 4, centred). The column wrappers drop out so the thumbs flow as one list. */
    @media (max-width: 1179px) {
      .nf-mosaic { --k: .6; display: block; }
      /* Full-width stage: the glow may not reach past the column (it would scroll the page) */
      .nf-stage-glow { inset: -9% 0 -15%; }
      .nf-thumbs {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 34px 18px;
        margin-top: 46px;
      }
      .nf-thumbs-col { display: contents; }
      .nf-thumb { width: calc((100% - 4 * 18px) / 5); }
    }
    /* Phone: no tilt; the thumbnails become a horizontal strip that bleeds to the screen edges
       (scrolls on its own, never the page) and the chip turns into a caption line. */
    @media (max-width: 639px) {
      .nf-mosaic { --k: 0; }
      /* Every pixel counts here: the stage bleeds into the section padding, short of the edges */
      .nf-stage { margin-inline: calc(-1 * clamp(22px, 5vw, 64px) + 8px); }
      .nf-stage-card { border-radius: 10px; }
      .nf-stage-chip { left: 10px; bottom: -12px; max-width: calc(100% - 20px); padding: 5px 9px; font-size: 10.5px; gap: 8px; }
      .nf-stage-play { width: 52px; height: 52px; margin: -26px 0 0 -26px; }
      .nf-thumbs {
        position: relative;
        flex-wrap: nowrap;
        justify-content: flex-start;
        gap: 12px;
        margin: 34px calc(-1 * clamp(22px, 5vw, 64px)) 0;
        padding: 4px clamp(22px, 5vw, 64px) 8px;
        overflow-x: auto;
        scroll-snap-type: x proximity;
        scroll-padding-inline: clamp(22px, 5vw, 64px);
        scrollbar-width: none;
      }
      .nf-thumbs::-webkit-scrollbar { display: none; }
      .nf-thumb { flex: 0 0 128px; width: 128px; scroll-snap-align: start; }
      .nf-thumb.is-active .nf-thumb-pin { transform: none; }
      .nf-thumb-card { border-radius: 8px; }
      .nf-thumb-chip {
        position: static;
        max-width: 100%;
        margin-top: 8px;
        padding: 0;
        font-size: 10px;
        color: var(--ink-dim);
        background: none;
        border: 0;
        box-shadow: none;
      }
      [data-theme='light'] .nf-thumb-chip { box-shadow: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .nf-thumb-pin, .nf-thumb-card, .nf-thumb-bar { transition: none; }
    }

    /* ── Neuron rail (home-only chrome) ─────────────────────────────────────── */
    /* Axon: a hairline fibre running behind the soma column (home → Download),
       with a lit overlay whose height tracks the page scroll progress (JS-driven,
       so it stays honest under prefers-reduced-motion — it only moves with scroll). */
    .nf-rail > * { position: relative; z-index: 1; }
    .nf-rail > .nf-axon {
      position: absolute;
      left: 50%;
      top: 0;
      height: 0; /* JS measures the first/last somas and sets top+height */
      width: 1px;
      margin-left: -0.5px;
      background: var(--line);
      opacity: .7;
      pointer-events: none;
      z-index: 0;
    }
    .nf-axon-fill {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 0%;
      background: var(--detail);
      box-shadow: 0 0 3px var(--detail);
      opacity: .55;
    }

    /* Scroll-spy: the neuron of the section in view stays "fired" (same look as
       the hover state in brain-site.css) and keeps its label pinned visible. */
    .nf-rail .nf-neuron.is-current .nf-soma { filter: drop-shadow(0 0 9px var(--c)); }
    .nf-rail .nf-neuron.is-current .nf-fill { opacity: 0.95; }
    .nf-rail .nf-neuron.is-current .nf-label {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
      pointer-events: auto;
      cursor: pointer;
    }

    /* Bottom cluster (language / theme): borderless buttons with a soft glow on hover. */
    .nf-rail .nf-lang-btn,
    .nf-rail .nf-theme-btn {
      transition: color 0.25s ease, filter 0.25s ease, transform 0.2s ease;
    }
    .nf-rail .nf-lang-btn:hover,
    .nf-rail .nf-theme-btn:hover {
      color: var(--ink-strong);
      filter: drop-shadow(0 0 6px var(--detail));
      transform: translateY(-1px);
      border-color: var(--detail);
    }

    /* ── Download-section copy plates ───────────────────────────────────────── */
    /* The whole download column sits directly on the ambient brain, and most of its copy is
       --ink-faint / --ink-dim, which the wireframe swallows. Each block of copy carries a
       scrim of the page background itself: where there is no wireframe it is invisible (the
       same colour as what it covers), and where there is one it knocks it back. Kept well
       under 100% on purpose — a solid plate would read as a card and break the "brain
       showing through the footer" effect. Padding is set per element so each plate hugs its
       own text. */
    .nf-plate {
      background: color-mix(in srgb, var(--bg) 76%, transparent);
      border-radius: 6px;
    }

    /* ── Grouped footer (Download section) ──────────────────────────────────── */
    /* Brand block takes the leftover space; the four link columns size to content. */
    .nf-footer-grid {
      display: grid;
      grid-template-columns: 1fr repeat(3, auto);
      column-gap: clamp(24px, 4.5vw, 60px);
      row-gap: 34px;
      align-items: start;
      /* One plate for the whole grid rather than one per column — four separate cards in a
         row would read as a component the design never had. The negative margins cancel the
         padding exactly, so the plate bleeds outwards and nothing in the grid moves; the
         -20px stays inside the content column's own padding, so it never clips. */
      margin: -16px -20px;
      padding: 16px 20px;
      border-radius: 8px;
      background: color-mix(in srgb, var(--bg) 76%, transparent);
    }
    .nf-footer-col { display: flex; flex-direction: column; gap: 11px; }
    .nf-footer-head {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--ink-dim);
      margin-bottom: 4px;
    }
    .nf-footer-col a {
      width: max-content;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: .02em;
      color: var(--ink-faint);
      transition: color 0.2s ease;
    }
    .nf-footer-col a:hover { color: var(--ink-strong); }
    @media (max-width: 780px) {
      /* Brand on its own row, then the four columns in a 2×2 grid. */
      .nf-footer-grid { grid-template-columns: repeat(2, 1fr); }
      .nf-footer-brand { grid-column: 1 / -1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .nf-footer-col a { transition: none; }
    }
  </style>

  <script>
    // ── NoteFlow marketing controller ──────────────────────────────────────────
    // Vanilla port of the design's DCLogic component: theme toggle, scroll reveals,
    // nav→brain hover synapses, the content-layer toggle, and the chat mock.
    type Brain = HTMLElement & {
      setHighlight?: (s: Set<string>) => void;
      setThinking?: (b: boolean) => void;
      setContentEdges?: (b: boolean) => void;
      setScroll?: (p: number) => void;
      _rebuildAll?: () => void;
    };

    const THEME_KEY = 'noteflow:web-theme';
    const root = document.documentElement;

    // Chat presets are localized in the frontmatter and shipped as a JSON <script>
    // tag (this module is bundled and can't read Astro props directly).
    type Preset = { q: string; a: string; cites: string[]; citeLabels: string[] };
    const presetEl = document.querySelector('[data-nf-i18n]');
    let PRESETS: Preset[] = [];
    try {
      PRESETS = presetEl ? (JSON.parse(presetEl.textContent || '[]') as Preset[]) : [];
    } catch {
      PRESETS = [];
    }

    const NAV_BRAIN: Record<string, string[]> = {
      home: ['reading', 'quotes', 'daily', 'ideas'],
      brain: ['rag', 'agents', 'eval', 'embeddings'],
      what: ['react-patterns', 'postgres', 'css-arch', 'k8s'],
      profile: ['reading', 'quotes', 'daily', 'ideas'],
      download: ['blog-brain', 'newsletter', 'roadmap', 'rag'],
    };
    const NAV_COLORS: Record<string, string> = {
      home: 'var(--ink-strong)', brain: 'rgb(var(--purple))', what: 'rgb(var(--accent))',
      profile: 'rgb(var(--orange))', download: 'rgb(var(--accent-2))',
    };

    // ── brain handles ──
    let controlsBrain: Brain | null = null;
    let ambientBrains: Brain[] = [];
    const grabBrains = () => {
      controlsBrain = document.querySelector('noteflow-brain[data-controls]');
      ambientBrains = Array.from(document.querySelectorAll('noteflow-brain[data-ambient]')) as Brain[];
    };
    grabBrains();
    window.addEventListener('nf-brain-ready', grabBrains);

    // ── hero scroll → the brain swells / dives in ──
    const heroBrainEl = document.getElementById('heroBrain') as Brain | null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let heroTick = false;
    const onHeroScroll = () => {
      heroTick = false;
      // Progress over the first viewport of scrolling (0 at the top → 1 a screen down).
      const p = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight || 1)));
      heroBrainEl?.setScroll?.(p);
    };
    if (!reduceMotion) {
      window.addEventListener('scroll', () => { if (!heroTick) { heroTick = true; requestAnimationFrame(onHeroScroll); } }, { passive: true });
      window.addEventListener('nf-brain-ready', onHeroScroll);
      onHeroScroll();
    }

    // ── "What is NoteFlow" mosaic: one stage, thumbnails as selectors, auto-rotation ──
    // A single <video> (the stage) plays the active clip; the thumbnails are posters only (CSS
    // backgrounds) and carry each clip's dark/light sources in data-* (lang/single clips repeat
    // the same file in both). The stage's <source>s ship empty: they're assigned once the stage
    // nears the viewport, for the current theme. The active clip plays without loop and, on
    // `ended`, the next one (circular, DOM order) takes the stage — only while it's on screen.
    // Click / Enter / Space on a thumbnail puts it on stage at once (and resumes playback if it
    // was paused); on hover-capable pointers a ~300ms dwell does too. The stage "rises" from the
    // chosen thumbnail (FLIP, Web Animations API). "Pause clips" stops playback AND rotation
    // (WCAG 2.2.2). Under prefers-reduced-motion: no autoplay, no rotation, no hover-select, no
    // FLIP — the visitor picks a clip and plays it.
    const mosaicEl = document.querySelector<HTMLElement>('[data-mosaic]');
    const stageEl = mosaicEl?.querySelector<HTMLElement>('[data-stage]') ?? null;
    const stagePin = mosaicEl?.querySelector<HTMLElement>('[data-stage-pin]') ?? null;
    const stageVideo = mosaicEl?.querySelector<HTMLVideoElement>('[data-stage-video]') ?? null;
    const stageCaption = mosaicEl?.querySelector<HTMLElement>('[data-stage-caption]') ?? null;
    const stageCount = mosaicEl?.querySelector<HTMLElement>('[data-stage-count]') ?? null;
    const stagePlay = mosaicEl?.querySelector<HTMLButtonElement>('[data-stage-play]') ?? null;
    const thumbStrip = mosaicEl?.querySelector<HTMLElement>('[data-thumbs]') ?? null;
    const thumbs = Array.from(mosaicEl?.querySelectorAll<HTMLButtonElement>('[data-thumb]') ?? []);
    const mosaicPauseBtn = document.querySelector<HTMLButtonElement>('[data-mosaic-pause]');
    const mosaicPauseLabel = mosaicPauseBtn?.querySelector<HTMLElement>('[data-mosaic-pause-label]') ?? null;
    const mosaicReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const LIFT_EASE = 'cubic-bezier(.2,.7,.2,1)';
    let stageActive = 0;
    let stageHeld = mosaicReduce.matches; // paused by the visitor, or reduced motion
    let stageArmed = false; // sources assigned (the stage has neared the viewport)
    let stageOnScreen = false;
    let progressRaf = 0;

    const clipTheme = () => (root.getAttribute('data-theme') === 'light' ? 'light' : 'dark');
    const thumbSources = (b: HTMLElement) => {
      const th = clipTheme();
      return { webm: b.dataset[`${th}Webm`] || '', mp4: b.dataset[`${th}Mp4`] || '', poster: b.dataset[`${th}Poster`] || '' };
    };
    const pad2 = (n: number) => String(n).padStart(2, '0');
    const playStage = () => { stageVideo?.play().catch(() => { /* blocked or interrupted — stays on the poster */ }); };
    const setProgress = (b: HTMLElement | undefined, p: number) => {
      const bar = b?.querySelector<HTMLElement>('[data-thumb-progress]');
      if (bar) bar.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`;
    };
    const renderMosaicBtn = () => {
      if (mosaicPauseBtn) {
        const label = (stageHeld ? mosaicPauseBtn.dataset.labelPlay : mosaicPauseBtn.dataset.labelPause) || '';
        mosaicPauseBtn.dataset.paused = stageHeld ? 'true' : 'false';
        if (mosaicPauseLabel) mosaicPauseLabel.textContent = label;
      }
      if (stagePlay) stagePlay.hidden = !stageHeld;
    };

    // Assign the active clip's sources for the current theme. `keepTime` (theme switch) resumes
    // the new take where the old one was; a file that doesn't change (lang/single clips) is left
    // playing untouched.
    const loadStage = (keepTime: boolean) => {
      const b = thumbs[stageActive];
      if (!stageVideo || !b) return;
      const s = thumbSources(b);
      if (s.poster && stageVideo.getAttribute('poster') !== s.poster) stageVideo.poster = s.poster;
      if (!stageArmed) return;
      const webm = stageVideo.querySelector<HTMLSourceElement>('source[type="video/webm"]');
      const mp4 = stageVideo.querySelector<HTMLSourceElement>('source[type="video/mp4"]');
      if (!webm || !mp4 || webm.getAttribute('src') === s.webm) return;
      const at = keepTime ? stageVideo.currentTime : 0;
      webm.src = s.webm;
      mp4.src = s.mp4;
      stageVideo.load();
      if (at > 0) {
        stageVideo.addEventListener('loadedmetadata', () => {
          stageVideo.currentTime = Math.min(at, Math.max(0, stageVideo.duration - 0.2));
        }, { once: true });
      }
      if (!stageHeld && stageOnScreen) playStage();
    };
    const armStage = () => {
      if (stageArmed || !stageVideo) return;
      stageArmed = true;
      stageVideo.preload = 'metadata';
      loadStage(false);
    };

    // Caption, counter, aria, tone and posters of the stage + the pressed state of the thumbs.
    const paintStageMeta = () => {
      const b = thumbs[stageActive];
      if (!b || !stageEl) return;
      stageEl.style.setProperty('--poster-dark', `url('${b.dataset.darkPoster || ''}')`);
      stageEl.style.setProperty('--poster-light', `url('${b.dataset.lightPoster || ''}')`);
      stageEl.style.setProperty('--tone', b.dataset.tone || '');
      stageVideo?.setAttribute('aria-label', b.dataset.label || '');
      if (stageCaption) stageCaption.textContent = b.dataset.caption || '';
      if (stageCount) stageCount.textContent = `${pad2(stageActive + 1)} / ${pad2(thumbs.length)}`;
      thumbs.forEach((t, i) => {
        const on = i === stageActive;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-pressed', on ? 'true' : 'false');
        if (!on) setProgress(t, 0);
      });
    };

    // "Rises above the board": the stage animates from the chosen thumbnail's rect to its own
    // (FLIP). If that thumbnail isn't visible (off screen, scrolled out of the phone strip) a
    // short fade + scale stands in.
    const liftFrom = (b: HTMLElement) => {
      if (!stagePin || mosaicReduce.matches || typeof stagePin.animate !== 'function') return;
      stagePin.getAnimations().forEach((a) => a.cancel());
      const to = stagePin.getBoundingClientRect();
      const from = b.querySelector('.nf-thumb-card')?.getBoundingClientRect();
      const clip = thumbStrip && thumbStrip.scrollWidth > thumbStrip.clientWidth + 1 ? thumbStrip.getBoundingClientRect() : null;
      const visible = !!from && from.width > 0 && to.width > 0 &&
        from.bottom > 0 && from.top < window.innerHeight && from.right > 0 && from.left < window.innerWidth &&
        (!clip || (from.left >= clip.left - 1 && from.right <= clip.right + 1));
      if (visible && from) {
        const dx = from.left - to.left, dy = from.top - to.top;
        stagePin.animate([
          { transformOrigin: '0 0', transform: `translate(${dx}px, ${dy}px) scale(${from.width / to.width}, ${from.height / to.height})`, opacity: 0.6 },
          { transformOrigin: '0 0', transform: 'none', opacity: 1 },
        ], { duration: 460, easing: LIFT_EASE });
      } else {
        stagePin.animate([
          { transform: 'scale(.97)', opacity: 0 },
          { transform: 'none', opacity: 1 },
        ], { duration: 340, easing: LIFT_EASE });
      }
    };
    // Phone strip: keep the clip on stage in view as the rotation advances (scrolls the strip
    // only — never the page).
    const revealThumb = (b: HTMLElement) => {
      if (!thumbStrip || thumbStrip.scrollWidth <= thumbStrip.clientWidth + 1) return;
      const sr = thumbStrip.getBoundingClientRect(), br = b.getBoundingClientRect();
      const pad = parseFloat(getComputedStyle(thumbStrip).paddingLeft) || 0;
      if (br.left >= sr.left + pad - 1 && br.right <= sr.right - pad + 1) return;
      thumbStrip.scrollTo({ left: thumbStrip.scrollLeft + (br.left - sr.left) - pad, behavior: mosaicReduce.matches ? 'auto' : 'smooth' });
    };

    type Pick = 'auto' | 'click' | 'hover';
    const selectClip = (i: number, how: Pick) => {
      if (!thumbs.length) return;
      const next = ((i % thumbs.length) + thumbs.length) % thumbs.length;
      // An explicit pick is a request to watch it: it lifts a pause (reduced motion included —
      // that playback is user-initiated, and it won't rotate on).
      if (how === 'click' && stageHeld) {
        stageHeld = false;
        renderMosaicBtn();
      }
      if (next === stageActive) {
        if (how === 'click') { armStage(); if (stageOnScreen) playStage(); }
        return;
      }
      stageActive = next;
      const b = thumbs[next];
      paintStageMeta();
      liftFrom(b);
      if (how === 'auto') revealThumb(b);
      if (how === 'click') armStage();
      loadStage(false);
    };

    if (mosaicEl && stageVideo && thumbs.length) {
      stageVideo.muted = true;
      mosaicEl.dataset.ready = '';
      loadStage(false);

      // Progress bar of the active thumbnail, frame-synced while playing.
      const tick = () => {
        const d = stageVideo.duration;
        if (d > 0) setProgress(thumbs[stageActive], stageVideo.currentTime / d);
        progressRaf = requestAnimationFrame(tick);
      };
      stageVideo.addEventListener('playing', () => { cancelAnimationFrame(progressRaf); progressRaf = requestAnimationFrame(tick); });
      ['pause', 'emptied'].forEach((ev) => stageVideo.addEventListener(ev, () => cancelAnimationFrame(progressRaf)));
      stageVideo.addEventListener('ended', () => {
        cancelAnimationFrame(progressRaf);
        setProgress(thumbs[stageActive], 1);
        if (mosaicReduce.matches) { stageHeld = true; renderMosaicBtn(); return; }
        if (!stageHeld && stageOnScreen) selectClip(stageActive + 1, 'auto');
      });

      thumbs.forEach((b, i) => {
        b.addEventListener('click', () => selectClip(i, 'click'));
        // Arrow keys walk the thumbnails (focus only; Enter/Space picks, as any button).
        b.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          thumbs[(i + step + thumbs.length) % thumbs.length].focus();
        });
      });
      // Hover with intent (~300ms dwell) on real pointers; never on touch (a tap would fire
      // mouseenter without a matching mouseleave) and never under reduced motion.
      if (window.matchMedia('(hover: hover)').matches) {
        thumbs.forEach((b, i) => {
          let dwell = 0;
          b.addEventListener('mouseenter', () => {
            clearTimeout(dwell);
            if (mosaicReduce.matches || i === stageActive) return;
            dwell = window.setTimeout(() => selectClip(i, 'hover'), 300);
          });
          b.addEventListener('mouseleave', () => clearTimeout(dwell));
        });
      }

      if ('IntersectionObserver' in window && stageEl) {
        new IntersectionObserver((entries) => {
          const e = entries[entries.length - 1];
          stageOnScreen = e.isIntersecting;
          if (stageOnScreen) {
            armStage();
            if (!stageHeld) playStage();
          } else if (!stageVideo.paused) {
            stageVideo.pause();
          }
        }, { rootMargin: '120px 0px' }).observe(stageEl);
      } else {
        stageOnScreen = true;
        armStage();
        if (!stageHeld) playStage();
      }

      const toggleHold = () => {
        stageHeld = !stageHeld;
        if (stageHeld) stageVideo.pause();
        else { armStage(); if (stageOnScreen) playStage(); }
        renderMosaicBtn();
      };
      mosaicPauseBtn?.addEventListener('click', toggleHold);
      stagePlay?.addEventListener('click', toggleHold);
      mosaicReduce.addEventListener?.('change', (e) => {
        if (!e.matches) return;
        stageHeld = true;
        stageVideo.pause();
        renderMosaicBtn();
      });
      if (mosaicPauseBtn) mosaicPauseBtn.hidden = false;
      renderMosaicBtn();
    }

    // ── theme ──
    const themeIcons = Array.from(document.querySelectorAll('.nf-theme-icon'));
    const syncThemeIcon = () => {
      const dark = root.getAttribute('data-theme') !== 'light';
      themeIcons.forEach((el) => (el.textContent = dark ? '☀' : '☾'));
      loadStage(true);
    };
    syncThemeIcon();

    const toggleTheme = () => {
      const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem(THEME_KEY, next); } catch {}
      syncThemeIcon();
      // Re-read palette + rebuild every brain so the wireframe recolours for the new theme.
      requestAnimationFrame(() => {
        document.querySelectorAll('noteflow-brain').forEach((b) => {
          const brain = b as Brain;
          if (brain._rebuildAll) brain._rebuildAll();
        });
        setTimeout(grabBrains, 60);
      });
    };
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', toggleTheme));

    // ── content-layer toggle ──
    let contentOn = true;
    const contentToggle = document.querySelector('[data-content-toggle]');
    const contentLabel = document.querySelector('[data-content-label]');
    const labelOn = contentToggle?.getAttribute('data-label-on') || 'Content layer · on';
    const labelOff = contentToggle?.getAttribute('data-label-off') || 'Content layer · off';
    contentToggle?.addEventListener('click', () => {
      contentOn = !contentOn;
      if (contentLabel) contentLabel.textContent = contentOn ? labelOn : labelOff;
      if (controlsBrain?.setContentEdges) controlsBrain.setContentEdges(contentOn);
    });

    // ── smooth-scroll nav + anchors ──
    const go = (id: string) => {
      const el = document.getElementById(id);
      if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 8, behavior: 'smooth' });
    };
    document.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = (a.getAttribute('href') || '').slice(1);
        if (id && document.getElementById(id)) { e.preventDefault(); go(id); }
      });
    });

    // ── rail scroll-spy + axon fill ──
    // The rail's "current" neuron fires (class `is-current`) for the section that
    // occupies the viewport; the axon overlay fills with overall scroll progress.
    // Both are pure functions of the scroll position (rAF-throttled), so they work
    // for wheel, keyboard, and smooth-scrolled anchor clicks alike.
    const railEl = document.querySelector<HTMLElement>('.nf-rail');
    const railNeurons = new Map<string, HTMLElement>();
    railEl?.querySelectorAll<HTMLElement>('[data-nav]').forEach((el) => railNeurons.set(el.dataset.nav!, el));
    // Sections in document order → their rail neuron key.
    const SPY: [string, string][] = [
      ['what', 'what'], ['brain', 'brain'], ['profile', 'profile'], ['get', 'download'],
    ];
    const axon = railEl?.querySelector<HTMLElement>('[data-axon]') ?? null;
    const axonFill = railEl?.querySelector<HTMLElement>('[data-axon-fill]') ?? null;

    // Stretch the axon from the home soma's centre down to the Download soma's
    // centre. The rail is fixed at top:0, so viewport coords are nav-local coords.
    const placeAxon = () => {
      const first = railNeurons.get('home')?.querySelector('.nf-soma');
      const last = railNeurons.get('download')?.querySelector('.nf-soma');
      if (!axon || !first || !last) return;
      const a = first.getBoundingClientRect(), b = last.getBoundingClientRect();
      const top = a.top + a.height / 2;
      axon.style.top = `${top}px`;
      axon.style.height = `${Math.max(0, b.top + b.height / 2 - top)}px`;
    };

    let spyCurrent = '';
    const spy = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      if (axonFill) axonFill.style.height = `${(p * 100).toFixed(2)}%`;

      // Current section = the last one whose top has crossed the upper 40% of the
      // viewport; none crossed (hero) → home; pinned to the end → Download.
      let key = 'home';
      const ref = window.innerHeight * 0.4;
      for (const [id, nav] of SPY) {
        const el = document.getElementById(id);
        if (el && el.getBoundingClientRect().top <= ref) key = nav;
      }
      if (max > 0 && window.scrollY >= max - 2) key = 'download';
      if (key !== spyCurrent) {
        spyCurrent = key;
        railNeurons.forEach((el, k) => el.classList.toggle('is-current', k === key));
      }
    };
    let spyTick = false;
    const onSpy = () => {
      if (spyTick) return;
      spyTick = true;
      requestAnimationFrame(() => { spyTick = false; spy(); });
    };
    window.addEventListener('scroll', onSpy, { passive: true });
    window.addEventListener('resize', () => { placeAxon(); onSpy(); });
    window.addEventListener('load', () => { placeAxon(); spy(); });
    placeAxon();
    spy();

    // ── nav → brain hover synapse overlay ──
    const ov = document.createElement('div');
    ov.style.cssText = 'position:fixed;inset:0;z-index:55;pointer-events:none;overflow:visible;';
    const NS = 'http://www.w3.org/2000/svg';
    const esvg = document.createElementNS(NS, 'svg');
    esvg.setAttribute('width', '100%'); esvg.setAttribute('height', '100%');
    esvg.style.cssText = 'position:absolute;inset:0;overflow:visible;';
    ov.appendChild(esvg); document.body.appendChild(ov);

    let edgeRaf = 0; let edgeClear = 0; let navClear = 0;
    const drawNavEdge = (key: string, btn: HTMLElement) => {
      cancelAnimationFrame(edgeRaf); clearTimeout(edgeClear);
      esvg.style.transition = ''; esvg.style.opacity = '1'; esvg.innerHTML = '';
      const r = btn.getBoundingClientRect();
      const x1 = r.right - 4, y1 = r.top + r.height / 2;
      // Land on the visible wireframe (roughly centre of the brain canvas).
      const tx = window.innerWidth * 0.5, ty = window.innerHeight * 0.42;
      const col = NAV_COLORS[key] || 'var(--detail)';

      // Build a polyline of straight segments that "passes through" a few nodes,
      // echoing the wireframe — no curves. Mid-nodes get a perpendicular jitter
      // (zero at the ends) so the path zig-zags through them like neural fibre.
      const dx = tx - x1, dy = ty - y1;
      const nlen = Math.hypot(dx, dy) || 1;
      const px = -dy / nlen, py = dx / nlen; // unit perpendicular
      const segs = 3;
      const pts: [number, number][] = [[x1, y1]];
      for (let i = 1; i < segs; i++) {
        const f = i / segs;
        const j = (Math.random() - 0.5) * 84 * Math.sin(Math.PI * f);
        pts.push([x1 + dx * f + px * j, y1 + dy * f + py * j]);
      }
      pts.push([tx, ty]);

      // Cumulative length at each vertex (for lighting nodes as the pulse passes).
      const cum: number[] = [0];
      for (let i = 1; i < pts.length; i++) {
        const l = Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);
        cum.push(cum[i - 1] + l);
      }
      const len = cum[cum.length - 1] || 1;

      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', 'M ' + pts.map((p) => p[0] + ' ' + p[1]).join(' L '));
      path.setAttribute('fill', 'none'); path.setAttribute('stroke', col);
      path.setAttribute('stroke-width', '1.5'); path.setAttribute('stroke-linejoin', 'round');
      path.style.filter = `drop-shadow(0 0 4px ${col})`;
      path.style.strokeDasharray = String(len); path.style.strokeDashoffset = String(len);
      esvg.appendChild(path);

      // A node sits at every vertex (start excluded), hidden until the pulse reaches it.
      const nodes = pts.slice(1).map((p, i) => {
        const last = i === pts.length - 2;
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', String(p[0])); c.setAttribute('cy', String(p[1]));
        c.setAttribute('r', String(last ? 3 : 2.4));
        c.setAttribute('fill', col); c.style.filter = `drop-shadow(0 0 6px ${col})`;
        c.style.opacity = '0';
        esvg.appendChild(c);
        return { el: c, at: cum[i + 1] };
      });

      // Travelling pulse dot.
      const dot = document.createElementNS(NS, 'circle');
      dot.setAttribute('r', '3'); dot.setAttribute('fill', col);
      dot.style.filter = `drop-shadow(0 0 7px ${col})`;
      esvg.appendChild(dot);

      // Landing ring that blooms where the fibre meets the wireframe.
      const landing = document.createElementNS(NS, 'circle');
      landing.setAttribute('cx', String(tx)); landing.setAttribute('cy', String(ty)); landing.setAttribute('r', '0');
      landing.setAttribute('fill', 'none'); landing.setAttribute('stroke', col); landing.setAttribute('stroke-width', '1.4');
      landing.style.filter = `drop-shadow(0 0 8px ${col})`; landing.style.opacity = '0';
      esvg.appendChild(landing);

      const t0 = performance.now(), dur = 480;
      const step = (now: number) => {
        const f = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - f, 3);
        const trav = len * e;
        path.style.strokeDashoffset = String(len - trav);
        const pt = path.getPointAtLength(trav);
        dot.setAttribute('cx', String(pt.x)); dot.setAttribute('cy', String(pt.y));
        dot.style.opacity = f < 0.96 ? '1' : '0';
        for (const n of nodes) n.el.style.opacity = trav >= n.at - 1 ? '0.95' : '0';
        if (f >= 0.62) { const g = (f - 0.62) / 0.38; landing.setAttribute('r', String(6 + g * 12)); landing.style.opacity = String((1 - g) * 0.85); }
        if (f < 1) edgeRaf = requestAnimationFrame(step);
      };
      edgeRaf = requestAnimationFrame(step);
    };
    const clearNavEdge = () => {
      cancelAnimationFrame(edgeRaf);
      esvg.style.transition = 'opacity .35s ease'; esvg.style.opacity = '0';
      clearTimeout(edgeClear);
      edgeClear = window.setTimeout(() => { esvg.innerHTML = ''; }, 380);
    };
    const navEnter = (key: string, btn: HTMLElement) => {
      drawNavEdge(key, btn);
      clearTimeout(navClear);
      const set = new Set(NAV_BRAIN[key] || []);
      ambientBrains.forEach((b) => { b.setHighlight?.(set); b.setThinking?.(true); });
    };
    const navLeave = () => {
      clearNavEdge();
      ambientBrains.forEach((b) => b.setThinking?.(false));
      clearTimeout(navClear);
      navClear = window.setTimeout(() => ambientBrains.forEach((b) => b.setHighlight?.(new Set())), 1100);
    };
    // Hover-only: on touch devices a tap fires mouseenter without a matching
    // mouseleave, leaving highlights/thinking stuck on the ambient brains.
    if (window.matchMedia('(hover: hover)').matches) {
      document.querySelectorAll<HTMLElement>('[data-nav]').forEach((el) => {
        const key = el.dataset.nav!;
        el.addEventListener('mouseenter', () => navEnter(key, el));
        el.addEventListener('mouseleave', navLeave);
      });
    }

    // ── chat mock ──
    const log = document.querySelector('[data-chat-log]') as HTMLElement | null;
    const hint = document.querySelector('[data-chat-hint]') as HTMLElement | null;
    let streaming = false; let tw = 0; let litClear = 0;
    const bubble = (user: boolean) => {
      const wrap = document.createElement('div');
      wrap.style.cssText = `display:flex;justify-content:${user ? 'flex-end' : 'flex-start'}`;
      const b = document.createElement('div');
      b.style.cssText =
        `max-width:86%;padding:11px 15px;border-radius:${user ? '14px 14px 4px 14px' : '14px 14px 14px 4px'};` +
        `font-size:16px;line-height:1.55;background:${user ? 'var(--card-2)' : 'transparent'};` +
        `border:1px solid ${user ? 'var(--line-2)' : 'var(--line)'};color:var(--ink);`;
      wrap.appendChild(b);
      log?.appendChild(wrap);
      return b;
    };
    const ask = (i: number) => {
      if (streaming || !log) return;
      const p = PRESETS[i];
      if (!p) return;
      hint?.remove();
      bubble(true).textContent = p.q;
      const ai = bubble(false);
      streaming = true;
      log.scrollTop = log.scrollHeight;
      if (controlsBrain) { controlsBrain.setThinking?.(true); controlsBrain.setHighlight?.(new Set(p.cites)); }
      let k = 0;
      clearInterval(tw);
      tw = window.setInterval(() => {
        k += 2;
        ai.textContent = p.a.slice(0, k);
        log.scrollTop = log.scrollHeight;
        if (k >= p.a.length) {
          clearInterval(tw);
          streaming = false;
          ai.textContent = p.a;
          const cites = document.createElement('div');
          cites.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;';
          p.citeLabels.forEach((c) => {
            const tag = document.createElement('span');
            tag.style.cssText =
              "display:inline-flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-dim);background:var(--card-2);border:1px solid var(--line-2);border-radius:7px;padding:4px 8px;";
            tag.innerHTML = '<span style="width:6px;height:6px;border-radius:50%;background:var(--detail);"></span>' + c;
            cites.appendChild(tag);
          });
          ai.appendChild(cites);
          if (controlsBrain) controlsBrain.setThinking?.(false);
          clearTimeout(litClear);
          litClear = window.setTimeout(() => controlsBrain?.setHighlight?.(new Set()), 4500);
        }
      }, 22);
    };
    document.querySelectorAll<HTMLElement>('[data-ask]').forEach((b) =>
      b.addEventListener('click', () => ask(Number(b.dataset.ask)))
    );

    // ── scroll reveals ──
    const reveals = Array.from(document.querySelectorAll('[data-reveal]')) as HTMLElement[];
    // `data-reveal-delay` (ms) staggers siblings that enter together (the mosaic tiles).
    const show = (el: HTMLElement) => {
      const delay = Number(el.dataset.revealDelay) || 0;
      el.style.animation = `riseIn .8s cubic-bezier(.2,.7,.2,1) ${delay}ms both`;
    };
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((ents) => {
        ents.forEach((e) => { if (e.isIntersecting) { show(e.target as HTMLElement); io.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
      reveals.forEach((el) => io.observe(el));
      // Safety net for anything on screen the observer didn't fire for. Only what is already in
      // (or above) the viewport — revealing everything would play the entrances off-screen.
      setTimeout(() => reveals.forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight) { show(el); io.unobserve(el); }
      }), 2600);
    } else {
      reveals.forEach((el) => (el.style.opacity = '1'));
    }

    // ── #get: upgrade the download buttons to the newest release's assets ──
    // Nothing about the release is baked at build time: asset names carry the version, and Pages
    // only redeploys on `docs/**` changes, so any baked number/URL would go stale on the next
    // release. Instead the buttons ship pointing at the *page* of the latest release — always
    // valid, and what the user gets without JS or with the API down (offline, 403 rate limit).
    // Here we ask the API (it already excludes prereleases) and, when the asset is there, swap in
    // its exact `browser_download_url` (read from the API, never rebuilt from a name pattern).
    // A direct binary shouldn't open a blank tab, so `target` goes away with the rewrite.
    // Missing asset → that button is left alone on /releases/latest, still a correct landing spot.
    (async () => {
      // `win` is the Microsoft Store button and stays as it is; the installer is `win-exe`.
      const win = document.querySelector<HTMLAnchorElement>('[data-dl="win-exe"]');
      const linux = document.querySelector<HTMLAnchorElement>('[data-dl="linux"]');
      if (!win && !linux) return;
      try {
        const res = await fetch('https://api.github.com/repos/yagoid/noteflow/releases/latest');
        if (!res.ok) return;
        const rel = (await res.json()) as {
          tag_name?: string;
          assets?: { name?: string; browser_download_url?: string }[];
        };
        const assets = rel.assets || [];
        const urlFor = (re: RegExp) =>
          assets.find((a) => re.test(a.name || ''))?.browser_download_url;
        // `$`-anchored so the `.blockmap` siblings never match.
        const toAsset = (a: HTMLAnchorElement | null, re: RegExp) => {
          const url = a && urlFor(re);
          if (!a || !url) return;
          a.href = url;
          a.removeAttribute('target');
        };

        toAsset(win, /-Setup\.exe$/);
        toAsset(linux, /_amd64\.deb$/);

        // Progressive enhancement: the version only shows once we know it for real.
        const label = document.querySelector<HTMLElement>('[data-dl-version]');
        const row = document.querySelector<HTMLElement>('[data-dl-version-row]');
        if (label && row && rel.tag_name) {
          label.textContent = rel.tag_name;
          row.style.visibility = 'visible';
        }
      } catch {
        /* keep the /releases/latest links */
      }
    })();
  </script>
</Base>
