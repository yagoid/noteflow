---
import Base from '../layouts/Base.astro';
import { asset } from '../lib/url';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getContent, type Lang, type NoteBlock } from '../i18n';
import { legalNoticeReady } from '../i18n/docs/legal-notice.owner';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
// Link to the opposite locale, respecting `base` and the no-prefix default scheme.
const switchHref = getRelativeLocaleUrl(otherLang, '');
// Long-form docs pages, in the current locale (footer links + contextual CTAs).
const cliHref = getRelativeLocaleUrl(lang, '/cli');
const aiHref = getRelativeLocaleUrl(lang, '/ai');
const featuresHref = getRelativeLocaleUrl(lang, '/features');
const pricingHref = getRelativeLocaleUrl(lang, '/pricing');
// Legal pages (footer-only links, no data-nav — the synapse script doesn't know them).
const privacyHref = getRelativeLocaleUrl(lang, '/privacy');
const termsHref = getRelativeLocaleUrl(lang, '/terms');
// Only linked once its owner data is filled in (otherwise the page is not generated).
const legalNoticeHref = getRelativeLocaleUrl(lang, '/legal-notice');
// Discreet ghost CTA style shared by the three docs links (echoes the hero CTA).
const docsCta =
  "display:inline-flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:13px;letter-spacing:.02em;color:var(--ink);background:transparent;border:1px solid var(--line-2);padding:11px 18px;border-radius:5px;";
// Secondary download button of the #get section (Linux). Same weight as the primary one:
// both are downloads, so neither should read as the lesser option.
const dlGhost =
  "display:inline-flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:14px;letter-spacing:.02em;color:var(--ink);background:transparent;border:1px solid var(--line-2);padding:16px 28px;border-radius:5px;";

const GITHUB = 'https://github.com/yagoid/noteflow';
// #get download buttons. Release assets carry the version in their file name, so there is no
// stable URL pointing at a binary — we link the *page* of the newest release (never 404s, never
// goes stale) and let the client script upgrade it to the exact asset. Nothing is baked at build
// time: Pages only redeploys on `docs/**` changes, so a baked version would lie after a release.
const RELEASES_LATEST_URL = `${GITHUB}/releases/latest`;
// Showcase clip: an in-app screen recording, one per theme. The poster (static PNG) shows
// while the video loads and is the fallback if autoplay is blocked.
const VID_DARK = asset('/video/demo-dark.mp4');
const VID_DARK_WEBM = asset('/video/demo-dark.webm');
const VID_LIGHT = asset('/video/demo-light.mp4');
const VID_LIGHT_WEBM = asset('/video/demo-light.webm');
const SHOT_DARK = asset('/screenshots/app-main-midnightblue.png');
const SHOT_LIGHT = asset('/screenshots/app-main-articday.png');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'NoteFlow',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Windows, Linux',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: 'https://yagoid.github.io/noteflow/',
  downloadUrl: 'https://github.com/yagoid/noteflow/releases',
  description: t.jsonLdDescription,
};

// Reusable inline style fragments (kept verbatim from the design for a faithful port).
const label =
  "font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--ink-faint);";
const cardP = 'margin:0;font-size:17px;line-height:1.5;color:var(--ink-dim);';

// ── Notes section: the feature set drawn as a *real* NoteFlow window ──
// Left = the app sidebar (each feature is a note, in colour-coded groups). Right =
// a faithful section-preview card (the editor mock) that swaps when a note is picked.
// Structural fields only (id/tok/time/mode + each tag's palette token) live here; all
// translatable copy (title/date/tag name/body) is read from the i18n dictionary.
type NoteId = keyof typeof t.notesSection.notes;
interface NoteMeta {
  id: NoteId;
  tok: string;
  time: string;    // short modified time in the sidebar item (e.g. 21:34)
  mode: 'rich' | 'raw';
  tagToks: string[];
}
const noteMeta: NoteMeta[] = [
  { id: 'brain', tok: 'purple', time: '22:10', mode: 'rich', tagToks: ['purple'] },
  { id: 'headless', tok: 'cyan', time: '20:48', mode: 'raw', tagToks: ['cyan'] },
  { id: 'import', tok: 'orange', time: '18:33', mode: 'rich', tagToks: ['orange'] },
  { id: 'ai', tok: 'accent', time: '16:05', mode: 'rich', tagToks: ['accent'] },
  { id: 'sticky', tok: 'pink', time: '13:27', mode: 'rich', tagToks: ['pink'] },
];

interface NoteFeature {
  id: string;
  tok: string;
  title: string;
  time: string;
  date: string;
  mode: 'rich' | 'raw';
  tags: { name: string; tok: string }[];
  body: NoteBlock[];
}
const noteFeatures: NoteFeature[] = noteMeta.map((m) => {
  const c = t.notesSection.notes[m.id];
  return {
    id: m.id,
    tok: m.tok,
    time: m.time,
    date: c.date,
    mode: m.mode,
    title: c.title,
    tags: m.tagToks.map((tok, i) => ({ tok, name: c.tags[i] })),
    body: c.body,
  };
});
const firstFeature = noteFeatures[0];

// Accent colour per Brain feature card (structural — matches the original design).
const brainCardColors = ['rgb(var(--accent))', 'rgb(var(--accent-2))', 'rgb(var(--purple))'];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} jsonLd={jsonLd}>
  <div data-root style="position:relative;width:100%;background:var(--bg);">
    <nf-netbg style="position:fixed;inset:0;z-index:0;pointer-events:none;"></nf-netbg>

    <!-- Vertical neuron rail -->
    <nav
      class="nf-rail"
      style="position:fixed;top:0;left:0;bottom:0;z-index:60;width:80px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:26px 0;background:var(--nav-bg, transparent);border-right:1px solid var(--line);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);"
    >
      <!-- Axon: a thin fibre behind the somas that lights up with scroll progress. -->
      <div class="nf-axon" data-axon aria-hidden="true"><div class="nf-axon-fill" data-axon-fill></div></div>

      <a href="#top" data-nav="home" class="nf-neuron" style="--c:var(--ink-strong);display:flex;align-items:center;justify-content:center;width:100%;height:52px;color:var(--c);">
        <svg class="nf-soma" width="26" height="26" viewBox="-13 -13 26 26" fill="none" stroke="currentColor" stroke-linecap="round">
          <circle cx="0" cy="0" r="7" stroke-width="1.4" opacity=".5"></circle>
          <circle class="nf-fill" cx="0" cy="0" r="3" fill="currentColor" stroke="none" opacity=".45"></circle>
        </svg>
        <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);"><b style="font-weight:600;letter-spacing:.04em;">NoteFlow</b> · {t.rail.home}</span>
      </a>

      <div style="display:flex;flex-direction:column;align-items:center;gap:30px;">
        <a href="#notes" data-nav="notes" class="nf-neuron" style="--c:rgb(var(--accent));display:flex;align-items:center;justify-content:center;width:100%;height:34px;color:var(--c);">
          <svg class="nf-soma" width="26" height="26" viewBox="-13 -13 26 26" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="0" cy="0" r="7" stroke-width="1.4" opacity=".5"></circle>
            <circle class="nf-fill" cx="0" cy="0" r="3" fill="currentColor" stroke="none" opacity=".53"></circle>
          </svg>
          <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);">{t.rail.notes}</span>
        </a>
        <a href="#themes" data-nav="themes" class="nf-neuron" style="--c:rgb(var(--pink));display:flex;align-items:center;justify-content:center;width:100%;height:34px;color:var(--c);">
          <svg class="nf-soma" width="26" height="26" viewBox="-13 -13 26 26" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="0" cy="0" r="7" stroke-width="1.4" opacity=".5"></circle>
            <circle class="nf-fill" cx="0" cy="0" r="3" fill="currentColor" stroke="none" opacity=".53"></circle>
          </svg>
          <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);">{t.rail.themes}</span>
        </a>
        <a href="#brain" data-nav="brain" class="nf-neuron" style="--c:rgb(var(--purple));display:flex;align-items:center;justify-content:center;width:100%;height:34px;color:var(--c);">
          <svg class="nf-soma" width="26" height="26" viewBox="-13 -13 26 26" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="0" cy="0" r="7" stroke-width="1.4" opacity=".5"></circle>
            <circle class="nf-fill" cx="0" cy="0" r="3" fill="currentColor" stroke="none" opacity=".53"></circle>
          </svg>
          <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);">{t.rail.brain}</span>
        </a>
        <a href="#profile" data-nav="profile" class="nf-neuron" style="--c:rgb(var(--orange));display:flex;align-items:center;justify-content:center;width:100%;height:34px;color:var(--c);">
          <svg class="nf-soma" width="26" height="26" viewBox="-13 -13 26 26" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="0" cy="0" r="7" stroke-width="1.4" opacity=".5"></circle>
            <circle class="nf-fill" cx="0" cy="0" r="3" fill="currentColor" stroke="none" opacity=".53"></circle>
          </svg>
          <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);">{t.rail.profile}</span>
        </a>
      </div>

      <div style="display:flex;flex-direction:column;align-items:center;gap:46px;">
        <a href="#get" data-nav="download" class="nf-neuron" style="--c:rgb(var(--accent-2));display:flex;align-items:center;justify-content:center;width:100%;height:40px;color:var(--c);">
          <svg class="nf-soma" width="30" height="30" viewBox="-15 -15 30 30" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="0" cy="0" r="8" stroke-width="1.5" opacity=".5"></circle>
            <circle class="nf-fill" cx="0" cy="0" r="3.4" fill="currentColor" stroke="none" opacity=".78"></circle>
          </svg>
          <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);">{t.rail.download}</span>
        </a>
        <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
          <a href={switchHref} class="nf-neuron nf-lang-btn" aria-label={t.langSwitch.aria} style="--c:var(--ink-dim);display:grid;place-items:center;width:36px;height:36px;background:transparent;color:var(--ink);text-decoration:none;font-size:12px;font-weight:600;letter-spacing:.04em;font-family:'JetBrains Mono',monospace;">{t.langSwitch.label}</a>
          <button data-theme-toggle aria-label={t.rail.toggleTheme} class="nf-neuron nf-theme-btn" style="--c:var(--ink-dim);display:grid;place-items:center;width:36px;height:36px;background:transparent;color:var(--ink);cursor:pointer;font-size:14px;font-family:'JetBrains Mono',monospace;border:1px solid var(--line-2);border-radius:0;appearance:none;-webkit-appearance:none;padding:0;">
            <span class="nf-theme-icon">☀</span>
          </button>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <header id="top" style="position:relative;min-height:100svh;display:flex;align-items:center;overflow:hidden;background:var(--hero-bg);">
      <noteflow-brain id="heroBrain" class="nf-brain-hero" data-ambient data-content-edges="true" data-cam="1.9" data-rotate-speed="0.4" data-shift-x="0.08" data-target-y="-0.04" style="position:absolute;inset:0;width:100%;height:100%;opacity:.82;"></noteflow-brain>
      <div style="position:absolute;inset:0;pointer-events:none;background:var(--hero-scrim);"></div>
      <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(0deg,var(--bg) 0%,transparent 26%);"></div>

      <div style="position:relative;z-index:3;max-width:1320px;margin:0 auto;padding:96px clamp(22px,5vw,64px) 0;width:100%;">
        <div class="nf-hero-copy" style="max-width:600px;">
          <div style={`display:flex;align-items:center;gap:13px;font-size:11.5px;letter-spacing:.28em;text-transform:uppercase;font-family:'JetBrains Mono',monospace;color:var(--ink-faint);animation:riseIn .8s .05s both;`}>
            <span style="width:22px;height:1px;background:var(--detail);display:inline-block;"></span>{t.hero.kicker}
          </div>
          <h1 class="nf-hero-title" style="margin:26px 0 0;font-size:clamp(56px,8.4vw,120px);line-height:.96;letter-spacing:-.022em;font-weight:500;color:var(--ink-strong);animation:riseIn .9s .12s both;" set:html={t.hero.title}></h1>
          <span style="display:block;width:76px;height:3px;margin-top:24px;background:var(--detail);border-radius:2px;animation:riseIn .9s .2s both;"></span>
          <p style="margin:28px 0 0;font-style:italic;font-size:clamp(20px,1.8vw,27px);line-height:1.4;color:var(--ink-faint);animation:riseIn .9s .3s both;">{t.hero.tagline}</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:40px;animation:riseIn .9s .38s both;">
            <a href="#get" data-nav="download" class="nf-lift" style="display:inline-flex;align-items:center;gap:9px;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:14px;letter-spacing:.02em;color:var(--bg);background:var(--ink-strong);padding:15px 26px;border-radius:5px;box-shadow:0 12px 36px rgba(0,0,0,.32);">{t.hero.download}</a>
            <a href="#brain" data-nav="brain" class="nf-ghost" style="display:inline-flex;align-items:center;gap:9px;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:14px;letter-spacing:.02em;color:var(--ink);background:transparent;border:1px solid var(--line-2);padding:15px 24px;border-radius:5px;">{t.hero.cta}</a>
          </div>
        </div>
      </div>

      <div style="position:absolute;bottom:26px;left:50%;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:9px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--ink-faint);">
        <span>{t.hero.scroll}</span>
        <span style="width:1px;height:32px;background:linear-gradient(var(--ink-faint),transparent);animation:bob 2.1s ease-in-out infinite;"></span>
      </div>
    </header>

    <main style="position:relative;z-index:2;background:transparent;">
      <!-- Notes -->
      <section id="notes" style="max-width:1240px;margin:0 auto;padding:clamp(90px,12vw,150px) clamp(22px,5vw,64px);">
        <div data-reveal style="max-width:760px;">
          <div style={`display:flex;align-items:center;gap:11px;margin-bottom:22px;${label}`}><span style="width:18px;height:1px;background:rgb(var(--accent));"></span>{t.notesSection.kicker}</div>
          <h2 style="margin:0;font-size:clamp(34px,5vw,60px);line-height:1.05;letter-spacing:-.015em;font-weight:500;color:var(--ink-strong);">{t.notesSection.h2}</h2>
          <p style="margin:24px 0 0;font-size:clamp(19px,1.5vw,22px);line-height:1.62;color:var(--ink-dim);">{t.notesSection.p}</p>
        </div>

        <!-- Two floating things, separated only by space: a list of NoteFlow note
             items (left, identical to the real dark sidebar) and the section-preview
             card for the picked note (right). No window chrome — just the pieces. -->
        <div class="nf-notes" data-reveal data-noteapp>
          <!-- ── The clickable notes — a faithful slice of the NoteFlow sidebar ── -->
          <div class="nf-note-list" role="tablist" aria-label={t.notesSection.listAria}>
            {noteFeatures.map((f) => (
              <button
                type="button"
                role="tab"
                aria-selected={f.id === firstFeature.id ? 'true' : 'false'}
                class={`nf-note${f.id === firstFeature.id ? ' is-active' : ''}`}
                data-note={f.id}
                style={`--ac:var(--nf-${f.tok});`}
                aria-label={f.title}
              >
                <span class="nf-note-top">
                  <span class="nf-note-title">{f.title}</span>
                  <span class="nf-note-time">{f.time}</span>
                </span>
                <span class="nf-note-tags">
                  {f.tags.map((tg) => (
                    <span class="nf-note-tag" style={`--tc:var(--nf-${tg.tok});`}>{tg.name}</span>
                  ))}
                </span>
              </button>
            ))}
          </div>

          <!-- ── The note content — a floating section-preview card that swaps ── -->
          <div class="nf-card-stage" data-noteapp-stage>
            {noteFeatures.map((f) => (
              <article
                class={`nf-card${f.id === firstFeature.id ? ' is-active' : ''}`}
                data-panel={f.id}
                style={`--ac:var(--nf-${f.tok});`}
                aria-hidden={f.id === firstFeature.id ? 'false' : 'true'}
              >
                {/* Section label — the card's identity (which tab this is) */}
                <div class="nf-card-sec">
                  <span class="nf-card-sec-dot"></span>
                  <span class="nf-card-sec-name">{f.tags[0].name}</span>
                  <span class="nf-card-sec-mode" title={f.mode === 'raw' ? t.notesSection.modeRaw : t.notesSection.modeRich}>{f.mode === 'raw' ? '✎' : '◉'}</span>
                </div>

                {/* Editor mock — title, date, a representational toolbar, then the body */}
                <div class="nf-card-doc">
                  <div class="nf-card-rise nf-card-head">
                    <div class="nf-card-title">{f.title}<span class="nf-card-caret"></span></div>
                    <div class="nf-card-date">{f.date}</div>
                  </div>
                  <div class="nf-card-rise nf-card-toolbar" aria-hidden="true">
                    {Array.from({ length: 6 }).map(() => <span></span>)}
                  </div>

                  <div class="nf-card-body">
                    {f.body.map((b) => {
                      if (b.t === 'p') return <p class="nf-card-rise nf-card-p" set:html={b.html} />;
                      if (b.t === 'ul') return (
                        <ul class="nf-card-rise nf-card-ul">
                          {b.items.map((it) => <li set:html={it} />)}
                        </ul>
                      );
                      if (b.t === 'check') return (
                        <ul class="nf-card-rise nf-card-check">
                          {b.items.map((it) => (
                            <li class={it.done ? 'is-done' : ''}><span class="nf-card-box">{it.done ? '✓' : ''}</span>{it.text}</li>
                          ))}
                        </ul>
                      );
                      if (b.t === 'kbd') return (
                        <div class="nf-card-rise nf-card-kbd">
                          {b.keys.map((k, i) => (
                            <>{i > 0 && <span class="nf-card-kbd-plus">+</span>}<kbd>{k}</kbd></>
                          ))}
                        </div>
                      );
                      if (b.t === 'code') return (
                        <pre class="nf-card-rise nf-card-code"><code>{b.lines.join('\n')}</code></pre>
                      );
                      if (b.t === 'tabs') return (
                        <div class="nf-card-rise nf-card-tabs">
                          {b.tabs.map((tb) => (
                            <span class="nf-card-tab" style={`--tc:var(--nf-${tb.tok});`}><span class="nf-card-tab-dot"></span>{tb.name}</span>
                          ))}
                        </div>
                      );
                      if (b.t === 'groups') return (
                        <div class="nf-card-rise nf-card-grouprows">
                          {b.rows.map((r) => (
                            <div class="nf-card-grouprow" style={`--tc:var(--nf-${r.tok});`}>
                              <span class="nf-card-grouprow-dot"></span>
                              <span class="nf-card-grouprow-name">{r.name}</span>
                              <span class="nf-card-grouprow-count">{r.count}</span>
                            </div>
                          ))}
                        </div>
                      );
                      return null;
                    })}
                  </div>

                  {/* Bottom fade — suggests there's more below the fold (like the real card) */}
                  <div class="nf-card-fade" aria-hidden="true"></div>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Contextual link to the CLI reference (the "Drive it headless" note above) -->
        <div data-reveal style="margin-top:34px;">
          <a href={cliHref} class="nf-ghost" style={docsCta}>{t.notesSection.cliCta}</a>
        </div>
      </section>

      <!-- Showcase -->
      <section id="themes" style="position:relative;background:transparent;border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;">
        <div style="max-width:1240px;margin:0 auto;padding:clamp(90px,12vw,150px) clamp(22px,5vw,64px);">
          <div data-reveal style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:28px;">
            <div style="max-width:660px;">
              <div style={`display:flex;align-items:center;gap:11px;margin-bottom:22px;${label}`}><span style="width:18px;height:1px;background:rgb(var(--pink));"></span>{t.showcase.kicker}</div>
              <h2 style="margin:0;font-size:clamp(34px,5vw,60px);line-height:1.05;letter-spacing:-.015em;font-weight:500;color:var(--ink-strong);" set:html={t.showcase.h2}></h2>
              <p style="margin:24px 0 0;font-size:clamp(19px,1.5vw,22px);line-height:1.6;color:var(--ink-dim);">{t.showcase.p}</p>
            </div>
            <button data-theme-toggle class="nf-edge" style="display:inline-flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.04em;color:var(--ink);background:var(--card);border:1px solid var(--line-2);border-radius:5px;padding:12px 16px;cursor:pointer;">
              <span style="width:9px;height:9px;border-radius:50%;background:var(--detail);box-shadow:0 0 12px var(--detail);"></span>{t.showcase.toggleTheme} <span class="nf-theme-icon">☀</span>
            </button>
          </div>

          <div data-reveal style="position:relative;margin-top:clamp(46px,6vw,72px);">
            <div style="position:absolute;inset:-8% -4% -14%;background:radial-gradient(60% 60% at 50% 40%,rgb(var(--accent)/.16),transparent 70%);filter:blur(30px);pointer-events:none;"></div>
            <div style="position:relative;border:1px solid var(--line-2);border-radius:14px;overflow:hidden;box-shadow:0 40px 100px -30px rgba(0,0,0,.5);background:var(--card);">
              <video data-shot
                data-shot-dark={VID_DARK} data-shot-dark-webm={VID_DARK_WEBM} data-shot-dark-poster={SHOT_DARK}
                data-shot-light={VID_LIGHT} data-shot-light-webm={VID_LIGHT_WEBM} data-shot-light-poster={SHOT_LIGHT}
                poster={SHOT_DARK} autoplay muted loop playsinline preload="metadata"
                aria-label={t.showcase.videoAria} width="1279" height="820"
                style="display:block;width:100%;height:auto;">
                <source data-shot-webm src={VID_DARK_WEBM} type="video/webm" />
                <source data-shot-mp4 src={VID_DARK} type="video/mp4" />
              </video>
            </div>
          </div>

          <div data-reveal style="display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:28px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-faint);">
            <span style="letter-spacing:.04em;">{t.showcase.themesLabel}</span>
            <div style="display:flex;gap:7px;align-items:center;">
              <span style="width:14px;height:14px;border-radius:5px;background:var(--bg);border:1px solid var(--line-2);"></span>
              <span style="width:14px;height:14px;border-radius:5px;background:rgb(var(--accent));"></span>
              <span style="width:14px;height:14px;border-radius:5px;background:rgb(var(--purple));"></span>
              <span style="width:14px;height:14px;border-radius:5px;background:rgb(var(--accent-2));"></span>
              <span style="width:14px;height:14px;border-radius:5px;background:rgb(var(--pink));"></span>
              <span style="width:14px;height:14px;border-radius:5px;background:#f1ead7;border:1px solid var(--line-2);"></span>
            </div>
            <span style="color:var(--ink-dim);">{t.showcase.themesCaption}</span>
            <a href={featuresHref} class="nf-ghost" style={`${docsCta}margin-left:auto;`}>{t.showcase.featuresCta}</a>
          </div>
        </div>
      </section>

      <!-- The Brain -->
      <section id="brain" style="position:relative;background:transparent;border-bottom:1px solid var(--line);overflow:hidden;">
        <div style="max-width:1300px;margin:0 auto;padding:clamp(90px,12vw,150px) clamp(22px,5vw,64px);">
          <div data-reveal style="max-width:780px;">
            <div style={`display:flex;align-items:center;gap:11px;margin-bottom:22px;${label}`}><span style="width:18px;height:1px;background:rgb(var(--purple));"></span>{t.brain.kicker}</div>
            <h2 style="margin:0;font-size:clamp(34px,5vw,60px);line-height:1.05;letter-spacing:-.015em;font-weight:500;color:var(--ink-strong);" set:html={t.brain.h2}></h2>
            <p style="margin:24px 0 0;font-size:clamp(19px,1.5vw,22px);line-height:1.6;color:var(--ink-dim);" set:html={t.brain.p}></p>
          </div>

          <div data-reveal style="display:flex;flex-wrap:wrap;gap:20px;margin-top:clamp(46px,6vw,64px);align-items:stretch;">
            <div style="flex:1 1 440px;position:relative;border:1px solid var(--line-2);border-radius:16px;overflow:hidden;background:var(--bg);min-height:540px;">
              <noteflow-brain class="nf-brain-panel" data-controls data-labels data-content-edges="true" data-cam="1.95" data-rotate-speed="0.3" data-target-y="0.03" style="position:absolute;inset:0;"></noteflow-brain>
              <div style="position:absolute;top:14px;left:14px;display:flex;gap:8px;z-index:4;pointer-events:auto;">
                <button data-content-toggle data-label-on={t.brain.contentOn} data-label-off={t.brain.contentOff} class="nf-edge" style="display:inline-flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--ink);background:var(--card-2);backdrop-filter:blur(8px);border:1px solid var(--line-2);border-radius:5px;padding:8px 11px;cursor:pointer;"><span style="width:8px;height:8px;border-radius:50%;background:var(--detail);box-shadow:0 0 8px var(--detail);"></span><span data-content-label>{t.brain.contentOn}</span></button>
              </div>
              <div style="position:absolute;bottom:14px;left:14px;z-index:4;font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);pointer-events:none;">{t.brain.hoverHint}</div>
            </div>

            <div style="flex:1 1 320px;display:flex;flex-direction:column;border:1px solid var(--line-2);border-radius:16px;background:var(--card);overflow:hidden;height:540px;max-height:540px;">
              <div style="display:flex;align-items:center;gap:10px;padding:15px 18px;border-bottom:1px solid var(--line);">
                <span style="width:9px;height:9px;border-radius:50%;background:var(--detail);box-shadow:0 0 12px var(--detail);"></span>
                <span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink);letter-spacing:.02em;">{t.brain.chatHeader}</span>
              </div>
              <div data-chat-log style="flex:1;min-height:0;display:flex;flex-direction:column;gap:12px;padding:18px;overflow-y:auto;">
                <div data-chat-hint style="margin:auto 0;text-align:center;color:var(--ink-faint);font-size:17px;line-height:1.6;padding:8px;font-style:italic;" set:html={t.brain.chatHint}></div>
              </div>
              <div style="padding:14px 16px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:8px;">
                <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-faint);">{t.brain.tryAsking}</div>
                <button data-ask="0" class="nf-suggest" style="text-align:left;font-size:16px;color:var(--ink);background:var(--card-2);border:1px solid var(--line);border-radius:5px;padding:10px 13px;cursor:pointer;">{t.chatPresets[0].q}</button>
                <button data-ask="1" class="nf-suggest" style="text-align:left;font-size:16px;color:var(--ink);background:var(--card-2);border:1px solid var(--line);border-radius:5px;padding:10px 13px;cursor:pointer;">{t.chatPresets[1].q}</button>
                <button data-ask="2" class="nf-suggest" style="text-align:left;font-size:16px;color:var(--ink);background:var(--card-2);border:1px solid var(--line);border-radius:5px;padding:10px 13px;cursor:pointer;">{t.chatPresets[2].q}</button>
              </div>
              <!-- Localized chat presets for the client script (it can't read the frontmatter). -->
              <script is:inline type="application/json" data-nf-i18n set:html={JSON.stringify(t.chatPresets)}></script>
            </div>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-top:40px;">
            {t.brain.cards.map((c, i) => (
              <div data-reveal style="padding-top:22px;border-top:1px solid var(--line-2);">
                <div style={`font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.18em;color:${brainCardColors[i]};margin-bottom:10px;`}>{c.tag}</div>
                <h3 style="margin:0 0 8px;font-size:22px;font-weight:600;color:var(--ink-strong);">{c.title}</h3>
                <p style={cardP}>{c.p}</p>
              </div>
            ))}
          </div>

          <!-- Contextual link to the AI internals deep dive -->
          <div data-reveal style="margin-top:38px;">
            <a href={aiHref} class="nf-ghost" style={docsCta}>{t.brain.aiCta}</a>
          </div>
        </div>
      </section>

      <!-- Profile -->
      <section id="profile" style="background:transparent;">
        <div style="max-width:1240px;margin:0 auto;padding:clamp(90px,12vw,150px) clamp(22px,5vw,64px);">
          <div data-reveal style="max-width:780px;">
            <div style={`display:flex;align-items:center;gap:11px;margin-bottom:22px;${label}`}><span style="width:18px;height:1px;background:rgb(var(--orange));"></span>{t.profile.kicker}</div>
            <h2 style="margin:0;font-size:clamp(34px,5vw,60px);line-height:1.05;letter-spacing:-.015em;font-weight:500;color:var(--ink-strong);" set:html={t.profile.h2}></h2>
            <p style="margin:24px 0 0;font-size:clamp(19px,1.5vw,22px);line-height:1.6;color:var(--ink-dim);" set:html={t.profile.p}></p>
          </div>

          <div data-reveal style="display:flex;flex-wrap:wrap;align-items:stretch;gap:18px;margin-top:clamp(46px,6vw,68px);">
            <div style="flex:1 1 320px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px;display:flex;flex-direction:column;gap:18px;">
              <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-faint);">{t.profile.signal.heading}</div>
              <div style="display:flex;flex-direction:column;gap:12px;">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;"><span style="font-size:17px;color:var(--ink-dim);">{t.profile.signal.weekends.label}</span><span style="display:inline-flex;border:1px solid var(--line-2);border-radius:9px;overflow:hidden;font-size:12px;font-family:'JetBrains Mono',monospace;"><span style="padding:7px 12px;background:rgb(var(--orange)/.18);color:rgb(var(--orange));">{t.profile.signal.weekends.a}</span><span style="padding:7px 12px;color:var(--ink-faint);">{t.profile.signal.weekends.b}</span></span></div>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;"><span style="font-size:17px;color:var(--ink-dim);">{t.profile.signal.recharge.label}</span><span style="display:inline-flex;border:1px solid var(--line-2);border-radius:9px;overflow:hidden;font-size:12px;font-family:'JetBrains Mono',monospace;"><span style="padding:7px 12px;color:var(--ink-faint);">{t.profile.signal.recharge.a}</span><span style="padding:7px 12px;background:rgb(var(--orange)/.18);color:rgb(var(--orange));">{t.profile.signal.recharge.b}</span></span></div>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;"><span style="font-size:17px;color:var(--ink-dim);">{t.profile.signal.deadlines.label}</span><span style="display:inline-flex;border:1px solid var(--line-2);border-radius:9px;overflow:hidden;font-size:12px;font-family:'JetBrains Mono',monospace;"><span style="padding:7px 12px;background:rgb(var(--orange)/.18);color:rgb(var(--orange));">{t.profile.signal.deadlines.a}</span><span style="padding:7px 12px;color:var(--ink-faint);">{t.profile.signal.deadlines.b}</span></span></div>
              </div>
              <div style="height:1px;background:var(--line);"></div>
              <div style="display:flex;flex-direction:column;gap:9px;">
                <div style="display:flex;align-items:center;gap:10px;background:var(--card-2);border:1px solid var(--line);border-radius:9px;padding:9px 12px;"><span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-faint);width:64px;">{t.profile.signal.albums.label}</span><span style="font-size:16px;color:var(--ink-dim);">{t.profile.signal.albums.value}</span></div>
                <div style="display:flex;align-items:center;gap:10px;background:var(--card-2);border:1px solid var(--line);border-radius:9px;padding:9px 12px;"><span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-faint);width:64px;">{t.profile.signal.dreamTrip.label}</span><span style="font-size:16px;color:var(--ink-dim);">{t.profile.signal.dreamTrip.value}</span></div>
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:8px;">
                <span style="display:inline-flex;align-items:center;gap:7px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-dim);background:var(--card-2);border:1px solid var(--line);border-radius:8px;padding:6px 10px;">CV.pdf</span>
                <span style="display:inline-flex;align-items:center;gap:7px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-dim);background:var(--card-2);border:1px solid var(--line);border-radius:8px;padding:6px 10px;">linkedin.com/in/…</span>
              </div>
            </div>

            <div style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;min-width:120px;">
              <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
                <div style="display:inline-flex;align-items:center;gap:9px;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:12.5px;letter-spacing:.02em;color:var(--bg);background:rgb(var(--orange));padding:11px 18px;border-radius:5px;box-shadow:0 10px 30px rgb(var(--orange)/.3);">✦ {t.profile.generate}</div>
                <span style="font-size:24px;color:rgb(var(--orange));">→</span>
              </div>
            </div>

            <div style="flex:1 1 320px;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;">
              <div style="display:flex;align-items:center;gap:9px;padding:13px 18px;border-bottom:1px solid var(--line);">
                <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;color:rgb(var(--orange));background:rgb(var(--orange)/.16);border-radius:6px;padding:3px 8px;">{t.profile.card.badge}</span>
                <span style="font-size:17px;font-weight:600;color:var(--ink-strong);">{t.profile.card.title}</span>
                <span style="margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-faint);">{t.profile.card.date}</span>
              </div>
              <div style="padding:22px;display:flex;flex-direction:column;gap:14px;font-size:17px;line-height:1.55;">
                <div><span style="font-weight:600;color:var(--ink-strong);">{t.profile.card.howYouWork.label}</span><div style="margin-top:7px;color:var(--ink-dim);">{t.profile.card.howYouWork.text}</div></div>
                <div><span style="font-weight:600;color:var(--ink-strong);">{t.profile.card.howToTalk.label}</span><div style="margin-top:7px;color:var(--ink-dim);">{t.profile.card.howToTalk.text}</div></div>
                <div style="margin-top:2px;padding-top:14px;border-top:1px dashed var(--line-2);font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-faint);">{t.profile.card.inferred}</div>
              </div>
            </div>
          </div>

          <p data-reveal style="margin:28px 0 0;max-width:720px;font-size:16px;line-height:1.6;color:var(--ink-faint);" set:html={t.profile.disclaimer}></p>
        </div>
      </section>
    </main>

    <!-- Download -->
    <footer id="get" style="position:relative;background:transparent;overflow:hidden;border-top:1px solid var(--line);">
      <noteflow-brain data-ambient data-transparent data-content-edges="true" data-cam="2.6" data-rotate-speed="0.3" data-shift-x="0" data-target-y="-0.05" style="position:absolute;inset:0;width:100%;height:100%;opacity:.6;"></noteflow-brain>
      <div style="position:absolute;inset:0;background:linear-gradient(0deg,var(--bg) 0%,transparent 45%,rgba(0,0,0,0) 100%);pointer-events:none;"></div>
      <div style="position:relative;z-index:2;max-width:900px;margin:0 auto;padding:clamp(90px,12vw,150px) clamp(22px,5vw,64px);text-align:center;">
        <div data-reveal>
          <div class="nf-plate" style={`display:inline-flex;align-items:center;gap:11px;margin-bottom:22px;padding:8px 14px;${label}`}><span style="width:18px;height:1px;background:var(--detail);"></span>{t.download.kicker}</div>
          <h2 style="margin:0;font-size:clamp(40px,6vw,82px);line-height:1.02;letter-spacing:-.018em;font-weight:500;color:var(--ink-strong);" set:html={t.download.h2}></h2>
          <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:42px;">
            <a href={RELEASES_LATEST_URL} data-dl="win" target="_blank" rel="noopener" class="nf-lift" style="display:inline-flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:14px;letter-spacing:.02em;color:var(--bg);background:var(--ink-strong);padding:16px 30px;border-radius:5px;box-shadow:0 12px 36px rgba(0,0,0,.32);">{t.download.windows}</a>
            <a href={RELEASES_LATEST_URL} data-dl="linux" target="_blank" rel="noopener" class="nf-ghost" style={dlGhost}>{t.download.linux}</a>
          </div>
          {/* Hidden until the client script reports the real tag_name — `visibility` (not `display`)
              so the reserved line never shifts what follows when it appears. It labels the two
              buttons above ("what you are about to download"), hence the tight margin. */}
          {/* `inline-block` so the plate hugs the line instead of spanning the whole column;
              the parent is text-align:center, so it still centres. */}
          <p data-dl-version-row class="nf-plate" style="visibility:hidden;display:inline-block;margin:16px 0 0;padding:7px 12px;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.02em;color:var(--ink-faint);">{t.download.versionLabel} <span data-dl-version></span></p>
          {/* max-width carries the horizontal padding on top of the original 460px text
              column (box-sizing is border-box site-wide), so the copy wraps exactly as before
              and only the plate is wider. */}
          <p class="nf-plate" style="margin:30px auto 0;max-width:496px;padding:12px 18px;font-size:17px;line-height:1.6;color:var(--ink-faint);" set:html={t.download.disclaimer}></p>
          {/* SmartScreen footnote for the Windows build (unsigned installer). Tinted with the
              site's amber `--detail` so it reads as a warning, but at footnote weight — it must
              not compete with the buttons or the privacy disclaimer above it. The amber rides
              on the same background scrim as `.nf-plate`, hence the nested color-mix. */}
          <div style="display:flex;gap:10px;align-items:flex-start;text-align:left;margin:22px auto 0;max-width:460px;padding:12px 14px;border:1px solid color-mix(in srgb, var(--detail) 26%, transparent);border-radius:6px;background:color-mix(in srgb, var(--detail) 6%, color-mix(in srgb, var(--bg) 76%, transparent));">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px;color:var(--detail);" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M12 8v4"></path>
              <path d="M12 16h.01"></path>
            </svg>
            <p style="margin:0;font-size:13.5px;line-height:1.55;color:var(--ink-dim);" set:html={t.download.winNote}></p>
          </div>
        </div>
        {/* Grouped footer: brand block + three link columns (Docs / Project / Legal),
            then the copyright row. Docs and legal links carry no data-nav — the synapse script
            only knows the in-page anchors. */}
        <div class="nf-footer" style="margin-top:clamp(60px,9vw,110px);padding-top:34px;border-top:1px solid var(--line);text-align:left;">
          <div class="nf-footer-grid">
            <div class="nf-footer-brand">
              <div style="display:flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--ink-dim);"><span style="width:9px;height:9px;border-radius:50%;background:var(--detail);flex:none;"></span>{t.download.footer.brand}</div>
              <p style="margin:12px 0 0;max-width:220px;font-size:14px;line-height:1.55;color:var(--ink-faint);">{t.download.footer.tagline}</p>
            </div>
            <div class="nf-footer-col">
              <div class="nf-footer-head">{t.download.footer.groups.docs}</div>
              <a href={cliHref}>{t.download.footer.cliDocs}</a>
              <a href={aiHref}>{t.download.footer.aiDocs}</a>
              <a href={featuresHref}>{t.download.footer.featuresDocs}</a>
              <a href={pricingHref}>{t.download.footer.pricingDocs}</a>
            </div>
            <div class="nf-footer-col">
              <div class="nf-footer-head">{t.download.footer.groups.project}</div>
              <a href={GITHUB} target="_blank" rel="noopener">{t.download.footer.source}</a>
              <a href={switchHref} aria-label={t.langSwitch.aria}>{t.langSwitch.label}</a>
            </div>
            <div class="nf-footer-col">
              <div class="nf-footer-head">{t.download.footer.groups.legal}</div>
              <a href={privacyHref}>{t.download.footer.privacy}</a>
              <a href={termsHref}>{t.download.footer.terms}</a>
              {legalNoticeReady && <a href={legalNoticeHref}>{t.download.footer.legalNotice}</a>}
              <a href={privacyHref} data-cookie-settings>{t.download.footer.cookies}</a>
            </div>
          </div>
          <div style="margin-top:clamp(30px,5vw,44px);padding-top:22px;border-top:1px solid var(--line);font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-faint);">{t.download.footer.copyright}</div>
        </div>
      </div>
    </footer>
  </div>

  <style is:global>
    /* ── Notes · floating NoteFlow note items + a floating section card ──────── */
    /* The block mirrors the real NoteFlow theme: Carbon-dark by default, Arctic-Day
       under the light site theme. Colours are the app's rgb triples (src/lib/themes.ts). */
    .nf-notes {
      --nf-bg-0: 9 9 9; --nf-bg-1: 17 17 17; --nf-bg-2: 26 26 26; --nf-bg-3: 38 38 38;
      --nf-bg-editor: 20 20 20; --nf-border: 42 42 42;
      --nf-text: 212 212 212; --nf-text-muted: 140 140 140;
      --nf-accent: 30 144 255; --nf-accent-2: 16 224 176; --nf-accent-3: 255 160 20;
      --nf-red: 255 56 56; --nf-cyan: 32 200 255; --nf-purple: 200 96 240;
      --nf-orange: 255 112 16; --nf-pink: 255 48 152;
      display: flex;
      align-items: flex-start;
      gap: clamp(62px, 8vw, 122px);
      margin-top: clamp(46px, 6vw, 72px);
      max-width: 960px;
    }
    /* Light site → NoteFlow's Arctic Day palette (so the widget recolours, not stays dark) */
    [data-theme='light'] .nf-notes {
      --nf-bg-0: 220 230 242; --nf-bg-1: 237 243 252; --nf-bg-2: 226 234 247; --nf-bg-3: 208 220 238;
      --nf-bg-editor: 237 243 252; --nf-border: 176 196 220;
      --nf-text: 26 38 64; --nf-text-muted: 74 94 122;
      --nf-accent: 14 78 168; --nf-accent-2: 8 120 95; --nf-accent-3: 150 96 4;
      --nf-red: 184 28 36; --nf-cyan: 10 110 152; --nf-purple: 112 36 150;
      --nf-orange: 156 58 2; --nf-pink: 156 18 96;
    }

    /* ── Left · the clickable notes (faithful to the dark sidebar) ── */
    .nf-note-list {
      flex: 0 0 auto;
      width: clamp(262px, 31%, 336px);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .nf-note {
      position: relative;
      display: block;
      width: 100%;
      text-align: left;
      padding: 11px 13px;
      border: 0;
      border-radius: 9px;
      background: transparent;
      cursor: pointer;
      font-family: 'Inter', system-ui, sans-serif;
      transition: background 0.18s ease, transform 0.18s ease;
    }
    .nf-note:hover { background: rgb(var(--nf-bg-3) / 0.85); }
    .nf-note.is-active {
      background: rgb(var(--ac) / 0.14);
    }
    .nf-note.is-active::before {
      content: '';
      position: absolute;
      left: 0; top: 10px; bottom: 10px;
      width: 2px;
      border-radius: 0 2px 2px 0;
      background: rgb(var(--ac));
      box-shadow: 0 0 10px rgb(var(--ac) / 0.7);
    }
    .nf-note:focus-visible { outline: 2px solid rgb(var(--ac) / 0.6); outline-offset: 2px; }

    .nf-note-top { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .nf-note-title {
      flex: 1;
      min-width: 0;
      font-size: 15px;
      font-weight: 500;
      color: rgb(var(--nf-text) / 0.82);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color 0.18s ease;
    }
    .nf-note:hover .nf-note-title,
    .nf-note.is-active .nf-note-title { color: rgb(var(--nf-text)); }
    .nf-note-time { font-size: 12px; color: rgb(var(--nf-text-muted) / 0.62); flex-shrink: 0; }
    .nf-note-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 7px; }
    /* Section tag — identical recipe to the app: colour text + 0.12 fill + 0.28 border */
    .nf-note-tag {
      font-size: 11.5px;
      line-height: 1.55;
      padding: 1px 6px;
      border-radius: 5px;
      color: rgb(var(--tc));
      background: rgb(var(--tc) / 0.12);
      border: 1px solid rgb(var(--tc) / 0.28);
    }

    /* ── Right · the floating section-preview card (swaps on select) ── */
    .nf-card-stage {
      flex: 1 1 0;
      min-width: 0;
      max-width: 480px;
      position: relative;
      height: clamp(356px, 40vw, 438px);
      border: 1px solid rgb(var(--nf-border) / 0.5);
      border-radius: 13px;
      overflow: hidden;
      /* Disguised, see-through panel: semi-transparent surface + frosted backdrop so the
         network background reads through it. */
      background: rgb(var(--nf-bg-editor) / 0.42);
      backdrop-filter: blur(9px);
      -webkit-backdrop-filter: blur(9px);
      box-shadow: 0 18px 48px -34px rgba(0, 0, 0, 0.5);
    }
    [data-theme='light'] .nf-card-stage { box-shadow: 0 16px 44px -36px rgba(40, 34, 24, 0.32); }
    .nf-card-stage::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(120% 80% at 80% 0%, rgb(var(--stage-ac, var(--nf-accent)) / 0.12), transparent 62%);
      transition: background 0.5s var(--ease);
      pointer-events: none;
      z-index: 0;
    }

    .nf-card {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px) scale(0.99);
      transition: opacity 0.4s var(--ease), transform 0.4s var(--ease), visibility 0s linear 0.4s;
      pointer-events: none;
    }
    .nf-card.is-active {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 0.44s var(--ease), transform 0.44s var(--ease);
      pointer-events: auto;
    }

    .nf-card-sec {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 11px 18px;
      border-bottom: 1px solid rgb(var(--nf-border));
      background: rgb(var(--ac) / 0.07);
      font-family: 'Inter', system-ui, sans-serif;
    }
    .nf-card-sec-dot { width: 9px; height: 9px; border-radius: 50%; background: rgb(var(--ac)); box-shadow: 0 0 12px rgb(var(--ac) / 0.7); }
    .nf-card-sec-name { font-size: 12.5px; font-weight: 600; color: rgb(var(--ac)); letter-spacing: 0.01em; }
    .nf-card-sec-mode { margin-left: auto; font-size: 11px; color: rgb(var(--nf-text-muted) / 0.7); }

    .nf-card-doc {
      position: relative;
      flex: 1;
      min-height: 0;
      padding: 18px clamp(18px, 2.4vw, 26px) 0;
      overflow: hidden;
      font-family: 'Inter', system-ui, sans-serif;
    }
    .nf-card-head { margin-bottom: 14px; }
    .nf-card-title {
      display: flex;
      align-items: center;
      font-size: clamp(19px, 2vw, 23px);
      font-weight: 700;
      color: rgb(var(--nf-text));
      letter-spacing: -0.015em;
    }
    .nf-card-caret { width: 2px; height: 1.05em; margin-left: 3px; background: rgb(var(--ac)); animation: nf-blink 1.1s steps(1) infinite; }
    @keyframes nf-blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }
    .nf-card-date { margin-top: 4px; font-size: 11.5px; color: rgb(var(--nf-text-muted) / 0.8); }

    .nf-card-toolbar {
      display: flex;
      align-items: center;
      gap: 6px;
      height: 22px;
      padding: 0 9px;
      border-radius: 6px;
      background: rgb(var(--nf-bg-0) / 0.7);
      border: 1px solid rgb(var(--nf-border));
      margin-bottom: 15px;
    }
    .nf-card-toolbar span { width: 14px; height: 6px; border-radius: 2px; background: rgb(var(--nf-text) / 0.12); }
    .nf-card-toolbar span:nth-child(3) { width: 9px; }
    .nf-card-toolbar span:nth-child(5) { width: 20px; }

    .nf-card-body { display: flex; flex-direction: column; gap: 14px; }
    .nf-card-p { margin: 0; font-size: 15.5px; line-height: 1.65; color: rgb(var(--nf-text) / 0.85); }
    .nf-card-p strong { color: rgb(var(--nf-text)); font-weight: 600; }
    .nf-card-p code, .nf-card-ul code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.84em;
      padding: 1px 5px;
      border-radius: 4px;
      background: rgb(var(--ac) / 0.15);
      color: rgb(var(--ac));
    }
    .nf-card-ul { margin: 0; padding-left: 3px; list-style: none; display: flex; flex-direction: column; gap: 8px; }
    .nf-card-ul li { position: relative; padding-left: 18px; font-size: 15px; line-height: 1.55; color: rgb(var(--nf-text) / 0.85); }
    .nf-card-ul li::before { content: ''; position: absolute; left: 2px; top: 0.62em; width: 6px; height: 6px; border-radius: 50%; background: rgb(var(--ac) / 0.8); }

    .nf-card-check { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .nf-card-check li { display: flex; align-items: center; gap: 11px; font-size: 15px; color: rgb(var(--nf-text) / 0.85); }
    .nf-card-check li.is-done { color: rgb(var(--nf-text-muted)); text-decoration: line-through; text-decoration-color: rgb(var(--ac) / 0.5); }
    .nf-card-box { flex-shrink: 0; width: 18px; height: 18px; display: grid; place-items: center; border-radius: 5px; border: 1.5px solid rgb(var(--nf-border)); font-size: 11px; color: rgb(var(--ac)); }
    .nf-card-check li.is-done .nf-card-box { background: rgb(var(--ac) / 0.16); border-color: rgb(var(--ac) / 0.6); }

    .nf-card-kbd { display: flex; align-items: center; gap: 6px; }
    .nf-card-kbd kbd { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: rgb(var(--nf-text)); background: rgb(var(--nf-bg-2)); border: 1px solid rgb(var(--nf-border)); border-bottom-width: 2px; border-radius: 6px; padding: 4px 9px; }
    .nf-card-kbd-plus { color: rgb(var(--nf-text-muted) / 0.7); font-size: 12px; }

    .nf-card-code {
      margin: 0;
      padding: 13px 15px;
      border-radius: 9px;
      background: rgb(var(--nf-bg-0) / 0.75);
      border: 1px solid rgb(var(--nf-border));
      border-left: 2px solid rgb(var(--ac) / 0.7);
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      line-height: 1.7;
      color: rgb(var(--nf-text) / 0.85);
      white-space: pre;
      overflow-x: auto;
    }

    .nf-card-tabs { display: flex; gap: 8px; flex-wrap: wrap; }
    .nf-card-tab { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; padding: 5px 12px; border-radius: 7px; color: rgb(var(--tc)); background: rgb(var(--tc) / 0.12); border: 1px solid rgb(var(--tc) / 0.30); }
    .nf-card-tab-dot { width: 6px; height: 6px; border-radius: 50%; background: rgb(var(--tc)); }

    .nf-card-grouprows { display: flex; flex-direction: column; gap: 8px; }
    .nf-card-grouprow { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; background: rgb(var(--tc) / 0.08); border: 1px solid rgb(var(--tc) / 0.22); }
    .nf-card-grouprow-dot { width: 9px; height: 9px; border-radius: 50%; background: rgb(var(--tc)); box-shadow: 0 0 8px rgb(var(--tc) / 0.6); }
    .nf-card-grouprow-name { font-size: 14px; color: rgb(var(--nf-text)); font-weight: 500; }
    .nf-card-grouprow-count { margin-left: auto; font-size: 12px; color: rgb(var(--nf-text-muted) / 0.85); }

    .nf-card-fade { position: absolute; inset-inline: 0; bottom: 0; height: 52px; background: linear-gradient(to top, rgb(var(--nf-bg-editor) / 0.6), transparent); pointer-events: none; z-index: 2; }

    /* Staggered rise of the card's inner blocks when it becomes active */
    .nf-card.is-active .nf-card-rise { animation: nf-card-rise 0.46s var(--ease) both; }
    .nf-card.is-active .nf-card-rise:nth-child(1) { animation-delay: 0.02s; }
    .nf-card.is-active .nf-card-rise:nth-child(2) { animation-delay: 0.08s; }
    .nf-card.is-active .nf-card-rise:nth-child(3) { animation-delay: 0.14s; }
    .nf-card.is-active .nf-card-rise:nth-child(4) { animation-delay: 0.20s; }
    .nf-card.is-active .nf-card-rise:nth-child(n + 5) { animation-delay: 0.26s; }
    @keyframes nf-card-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

    @media (max-width: 760px) {
      .nf-notes { flex-direction: column; max-width: none; }
      /* overscroll-behavior-x keeps the edge-of-scroller swipe from triggering the
         browser's back gesture on Android. */
      .nf-note-list { width: 100%; flex-direction: row; overflow-x: auto; gap: 8px; padding-bottom: 4px; overscroll-behavior-x: contain; }
      .nf-note { flex: 0 0 auto; width: 232px; }
      /* flex: 0 0 auto — the base `flex: 1 1 0` would make flex-basis:0 win over the
         height in the column direction and collapse the stage to its borders. */
      .nf-card-stage { width: 100%; max-width: none; height: 400px; flex: 0 0 auto; }
    }
    @media (prefers-reduced-motion: reduce) {
      .nf-card, .nf-card.is-active { transition: opacity 0.2s linear; transform: none; }
      .nf-card.is-active .nf-card-rise { animation: none; }
      .nf-card-caret { animation: none; }
    }

    /* ── Neuron rail (home-only chrome) ─────────────────────────────────────── */
    /* Axon: a hairline fibre running behind the soma column (home → Download),
       with a lit overlay whose height tracks the page scroll progress (JS-driven,
       so it stays honest under prefers-reduced-motion — it only moves with scroll). */
    .nf-rail > * { position: relative; z-index: 1; }
    .nf-rail > .nf-axon {
      position: absolute;
      left: 50%;
      top: 0;
      height: 0; /* JS measures the first/last somas and sets top+height */
      width: 1px;
      margin-left: -0.5px;
      background: var(--line);
      opacity: .7;
      pointer-events: none;
      z-index: 0;
    }
    .nf-axon-fill {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 0%;
      background: var(--detail);
      box-shadow: 0 0 3px var(--detail);
      opacity: .55;
    }

    /* Scroll-spy: the neuron of the section in view stays "fired" (same look as
       the hover state in brain-site.css) and keeps its label pinned visible. */
    .nf-rail .nf-neuron.is-current .nf-soma { filter: drop-shadow(0 0 9px var(--c)); }
    .nf-rail .nf-neuron.is-current .nf-fill { opacity: 0.95; }
    .nf-rail .nf-neuron.is-current .nf-label {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
      pointer-events: auto;
      cursor: pointer;
    }

    /* Bottom cluster (language / theme): borderless buttons with a soft glow on hover. */
    .nf-rail .nf-lang-btn,
    .nf-rail .nf-theme-btn {
      transition: color 0.25s ease, filter 0.25s ease, transform 0.2s ease;
    }
    .nf-rail .nf-lang-btn:hover,
    .nf-rail .nf-theme-btn:hover {
      color: var(--ink-strong);
      filter: drop-shadow(0 0 6px var(--detail));
      transform: translateY(-1px);
      border-color: var(--detail);
    }

    /* ── Download-section copy plates ───────────────────────────────────────── */
    /* The whole download column sits directly on the ambient brain, and most of its copy is
       --ink-faint / --ink-dim, which the wireframe swallows. Each block of copy carries a
       scrim of the page background itself: where there is no wireframe it is invisible (the
       same colour as what it covers), and where there is one it knocks it back. Kept well
       under 100% on purpose — a solid plate would read as a card and break the "brain
       showing through the footer" effect. Padding is set per element so each plate hugs its
       own text. */
    .nf-plate {
      background: color-mix(in srgb, var(--bg) 76%, transparent);
      border-radius: 6px;
    }

    /* ── Grouped footer (Download section) ──────────────────────────────────── */
    /* Brand block takes the leftover space; the four link columns size to content. */
    .nf-footer-grid {
      display: grid;
      grid-template-columns: 1fr repeat(3, auto);
      column-gap: clamp(24px, 4.5vw, 60px);
      row-gap: 34px;
      align-items: start;
      /* One plate for the whole grid rather than one per column — four separate cards in a
         row would read as a component the design never had. The negative margins cancel the
         padding exactly, so the plate bleeds outwards and nothing in the grid moves; the
         -20px stays inside the content column's own padding, so it never clips. */
      margin: -16px -20px;
      padding: 16px 20px;
      border-radius: 8px;
      background: color-mix(in srgb, var(--bg) 76%, transparent);
    }
    .nf-footer-col { display: flex; flex-direction: column; gap: 11px; }
    .nf-footer-head {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--ink-dim);
      margin-bottom: 4px;
    }
    .nf-footer-col a {
      width: max-content;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: .02em;
      color: var(--ink-faint);
      transition: color 0.2s ease;
    }
    .nf-footer-col a:hover { color: var(--ink-strong); }
    @media (max-width: 780px) {
      /* Brand on its own row, then the four columns in a 2×2 grid. */
      .nf-footer-grid { grid-template-columns: repeat(2, 1fr); }
      .nf-footer-brand { grid-column: 1 / -1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .nf-footer-col a { transition: none; }
    }
  </style>

  <script>
    // ── NoteFlow marketing controller ──────────────────────────────────────────
    // Vanilla port of the design's DCLogic component: theme toggle, scroll reveals,
    // nav→brain hover synapses, the content-layer toggle, and the chat mock.
    type Brain = HTMLElement & {
      setHighlight?: (s: Set<string>) => void;
      setThinking?: (b: boolean) => void;
      setContentEdges?: (b: boolean) => void;
      setScroll?: (p: number) => void;
      _rebuildAll?: () => void;
    };

    const THEME_KEY = 'noteflow:web-theme';
    const root = document.documentElement;

    // Chat presets are localized in the frontmatter and shipped as a JSON <script>
    // tag (this module is bundled and can't read Astro props directly).
    type Preset = { q: string; a: string; cites: string[]; citeLabels: string[] };
    const presetEl = document.querySelector('[data-nf-i18n]');
    let PRESETS: Preset[] = [];
    try {
      PRESETS = presetEl ? (JSON.parse(presetEl.textContent || '[]') as Preset[]) : [];
    } catch {
      PRESETS = [];
    }

    const NAV_BRAIN: Record<string, string[]> = {
      home: ['reading', 'quotes', 'daily', 'ideas'],
      brain: ['rag', 'agents', 'eval', 'embeddings'],
      notes: ['react-patterns', 'postgres', 'css-arch', 'k8s'],
      themes: ['react-patterns', 'css-arch', 'daily', 'ideas'],
      profile: ['reading', 'quotes', 'daily', 'ideas'],
      download: ['blog-brain', 'newsletter', 'roadmap', 'rag'],
    };
    const NAV_COLORS: Record<string, string> = {
      home: 'var(--ink-strong)', brain: 'rgb(var(--purple))', notes: 'rgb(var(--accent))',
      themes: 'rgb(var(--pink))', profile: 'rgb(var(--orange))', download: 'rgb(var(--accent-2))',
    };

    // ── brain handles ──
    let controlsBrain: Brain | null = null;
    let ambientBrains: Brain[] = [];
    const grabBrains = () => {
      controlsBrain = document.querySelector('noteflow-brain[data-controls]');
      ambientBrains = Array.from(document.querySelectorAll('noteflow-brain[data-ambient]')) as Brain[];
    };
    grabBrains();
    window.addEventListener('nf-brain-ready', grabBrains);

    // ── hero scroll → the brain swells / dives in ──
    const heroBrainEl = document.getElementById('heroBrain') as Brain | null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let heroTick = false;
    const onHeroScroll = () => {
      heroTick = false;
      // Progress over the first viewport of scrolling (0 at the top → 1 a screen down).
      const p = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight || 1)));
      heroBrainEl?.setScroll?.(p);
    };
    if (!reduceMotion) {
      window.addEventListener('scroll', () => { if (!heroTick) { heroTick = true; requestAnimationFrame(onHeroScroll); } }, { passive: true });
      window.addEventListener('nf-brain-ready', onHeroScroll);
      onHeroScroll();
    }

    // ── theme ──
    const themeIcons = Array.from(document.querySelectorAll('.nf-theme-icon'));
    const syncThemeIcon = () => {
      const dark = root.getAttribute('data-theme') !== 'light';
      themeIcons.forEach((el) => (el.textContent = dark ? '☀' : '☾'));
      const shot = document.querySelector('video[data-shot]') as HTMLVideoElement | null;
      if (shot) {
        const mp4 = dark ? shot.dataset.shotDark! : shot.dataset.shotLight!;
        const webm = dark ? shot.dataset.shotDarkWebm! : shot.dataset.shotLightWebm!;
        const poster = dark ? shot.dataset.shotDarkPoster! : shot.dataset.shotLightPoster!;
        const srcMp4 = shot.querySelector('source[data-shot-mp4]') as HTMLSourceElement | null;
        const srcWebm = shot.querySelector('source[data-shot-webm]') as HTMLSourceElement | null;
        // only reload if the clip actually changed (avoids restarting on every icon sync)
        if (srcMp4 && srcMp4.getAttribute('src') !== mp4) {
          if (srcWebm) srcWebm.src = webm;
          srcMp4.src = mp4;
          shot.poster = poster;
          shot.load();
          shot.play().catch(() => {});
        }
      }
    };
    syncThemeIcon();

    const toggleTheme = () => {
      const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem(THEME_KEY, next); } catch {}
      syncThemeIcon();
      // Re-read palette + rebuild every brain so the wireframe recolours for the new theme.
      requestAnimationFrame(() => {
        document.querySelectorAll('noteflow-brain').forEach((b) => {
          const brain = b as Brain;
          if (brain._rebuildAll) brain._rebuildAll();
        });
        setTimeout(grabBrains, 60);
      });
    };
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', toggleTheme));

    // ── content-layer toggle ──
    let contentOn = true;
    const contentToggle = document.querySelector('[data-content-toggle]');
    const contentLabel = document.querySelector('[data-content-label]');
    const labelOn = contentToggle?.getAttribute('data-label-on') || 'Content layer · on';
    const labelOff = contentToggle?.getAttribute('data-label-off') || 'Content layer · off';
    contentToggle?.addEventListener('click', () => {
      contentOn = !contentOn;
      if (contentLabel) contentLabel.textContent = contentOn ? labelOn : labelOff;
      if (controlsBrain?.setContentEdges) controlsBrain.setContentEdges(contentOn);
    });

    // ── smooth-scroll nav + anchors ──
    const go = (id: string) => {
      const el = document.getElementById(id);
      if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 8, behavior: 'smooth' });
    };
    document.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = (a.getAttribute('href') || '').slice(1);
        if (id && document.getElementById(id)) { e.preventDefault(); go(id); }
      });
    });

    // ── rail scroll-spy + axon fill ──
    // The rail's "current" neuron fires (class `is-current`) for the section that
    // occupies the viewport; the axon overlay fills with overall scroll progress.
    // Both are pure functions of the scroll position (rAF-throttled), so they work
    // for wheel, keyboard, and smooth-scrolled anchor clicks alike.
    const railEl = document.querySelector<HTMLElement>('.nf-rail');
    const railNeurons = new Map<string, HTMLElement>();
    railEl?.querySelectorAll<HTMLElement>('[data-nav]').forEach((el) => railNeurons.set(el.dataset.nav!, el));
    // Sections in document order → their rail neuron key.
    const SPY: [string, string][] = [
      ['notes', 'notes'], ['themes', 'themes'], ['brain', 'brain'], ['profile', 'profile'], ['get', 'download'],
    ];
    const axon = railEl?.querySelector<HTMLElement>('[data-axon]') ?? null;
    const axonFill = railEl?.querySelector<HTMLElement>('[data-axon-fill]') ?? null;

    // Stretch the axon from the home soma's centre down to the Download soma's
    // centre. The rail is fixed at top:0, so viewport coords are nav-local coords.
    const placeAxon = () => {
      const first = railNeurons.get('home')?.querySelector('.nf-soma');
      const last = railNeurons.get('download')?.querySelector('.nf-soma');
      if (!axon || !first || !last) return;
      const a = first.getBoundingClientRect(), b = last.getBoundingClientRect();
      const top = a.top + a.height / 2;
      axon.style.top = `${top}px`;
      axon.style.height = `${Math.max(0, b.top + b.height / 2 - top)}px`;
    };

    let spyCurrent = '';
    const spy = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      if (axonFill) axonFill.style.height = `${(p * 100).toFixed(2)}%`;

      // Current section = the last one whose top has crossed the upper 40% of the
      // viewport; none crossed (hero) → home; pinned to the end → Download.
      let key = 'home';
      const ref = window.innerHeight * 0.4;
      for (const [id, nav] of SPY) {
        const el = document.getElementById(id);
        if (el && el.getBoundingClientRect().top <= ref) key = nav;
      }
      if (max > 0 && window.scrollY >= max - 2) key = 'download';
      if (key !== spyCurrent) {
        spyCurrent = key;
        railNeurons.forEach((el, k) => el.classList.toggle('is-current', k === key));
      }
    };
    let spyTick = false;
    const onSpy = () => {
      if (spyTick) return;
      spyTick = true;
      requestAnimationFrame(() => { spyTick = false; spy(); });
    };
    window.addEventListener('scroll', onSpy, { passive: true });
    window.addEventListener('resize', () => { placeAxon(); onSpy(); });
    window.addEventListener('load', () => { placeAxon(); spy(); });
    placeAxon();
    spy();

    // ── nav → brain hover synapse overlay ──
    const ov = document.createElement('div');
    ov.style.cssText = 'position:fixed;inset:0;z-index:55;pointer-events:none;overflow:visible;';
    const NS = 'http://www.w3.org/2000/svg';
    const esvg = document.createElementNS(NS, 'svg');
    esvg.setAttribute('width', '100%'); esvg.setAttribute('height', '100%');
    esvg.style.cssText = 'position:absolute;inset:0;overflow:visible;';
    ov.appendChild(esvg); document.body.appendChild(ov);

    let edgeRaf = 0; let edgeClear = 0; let navClear = 0;
    const drawNavEdge = (key: string, btn: HTMLElement) => {
      cancelAnimationFrame(edgeRaf); clearTimeout(edgeClear);
      esvg.style.transition = ''; esvg.style.opacity = '1'; esvg.innerHTML = '';
      const r = btn.getBoundingClientRect();
      const x1 = r.right - 4, y1 = r.top + r.height / 2;
      // Land on the visible wireframe (roughly centre of the brain canvas).
      const tx = window.innerWidth * 0.5, ty = window.innerHeight * 0.42;
      const col = NAV_COLORS[key] || 'var(--detail)';

      // Build a polyline of straight segments that "passes through" a few nodes,
      // echoing the wireframe — no curves. Mid-nodes get a perpendicular jitter
      // (zero at the ends) so the path zig-zags through them like neural fibre.
      const dx = tx - x1, dy = ty - y1;
      const nlen = Math.hypot(dx, dy) || 1;
      const px = -dy / nlen, py = dx / nlen; // unit perpendicular
      const segs = 3;
      const pts: [number, number][] = [[x1, y1]];
      for (let i = 1; i < segs; i++) {
        const f = i / segs;
        const j = (Math.random() - 0.5) * 84 * Math.sin(Math.PI * f);
        pts.push([x1 + dx * f + px * j, y1 + dy * f + py * j]);
      }
      pts.push([tx, ty]);

      // Cumulative length at each vertex (for lighting nodes as the pulse passes).
      const cum: number[] = [0];
      for (let i = 1; i < pts.length; i++) {
        const l = Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);
        cum.push(cum[i - 1] + l);
      }
      const len = cum[cum.length - 1] || 1;

      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', 'M ' + pts.map((p) => p[0] + ' ' + p[1]).join(' L '));
      path.setAttribute('fill', 'none'); path.setAttribute('stroke', col);
      path.setAttribute('stroke-width', '1.5'); path.setAttribute('stroke-linejoin', 'round');
      path.style.filter = `drop-shadow(0 0 4px ${col})`;
      path.style.strokeDasharray = String(len); path.style.strokeDashoffset = String(len);
      esvg.appendChild(path);

      // A node sits at every vertex (start excluded), hidden until the pulse reaches it.
      const nodes = pts.slice(1).map((p, i) => {
        const last = i === pts.length - 2;
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', String(p[0])); c.setAttribute('cy', String(p[1]));
        c.setAttribute('r', String(last ? 3 : 2.4));
        c.setAttribute('fill', col); c.style.filter = `drop-shadow(0 0 6px ${col})`;
        c.style.opacity = '0';
        esvg.appendChild(c);
        return { el: c, at: cum[i + 1] };
      });

      // Travelling pulse dot.
      const dot = document.createElementNS(NS, 'circle');
      dot.setAttribute('r', '3'); dot.setAttribute('fill', col);
      dot.style.filter = `drop-shadow(0 0 7px ${col})`;
      esvg.appendChild(dot);

      // Landing ring that blooms where the fibre meets the wireframe.
      const landing = document.createElementNS(NS, 'circle');
      landing.setAttribute('cx', String(tx)); landing.setAttribute('cy', String(ty)); landing.setAttribute('r', '0');
      landing.setAttribute('fill', 'none'); landing.setAttribute('stroke', col); landing.setAttribute('stroke-width', '1.4');
      landing.style.filter = `drop-shadow(0 0 8px ${col})`; landing.style.opacity = '0';
      esvg.appendChild(landing);

      const t0 = performance.now(), dur = 480;
      const step = (now: number) => {
        const f = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - f, 3);
        const trav = len * e;
        path.style.strokeDashoffset = String(len - trav);
        const pt = path.getPointAtLength(trav);
        dot.setAttribute('cx', String(pt.x)); dot.setAttribute('cy', String(pt.y));
        dot.style.opacity = f < 0.96 ? '1' : '0';
        for (const n of nodes) n.el.style.opacity = trav >= n.at - 1 ? '0.95' : '0';
        if (f >= 0.62) { const g = (f - 0.62) / 0.38; landing.setAttribute('r', String(6 + g * 12)); landing.style.opacity = String((1 - g) * 0.85); }
        if (f < 1) edgeRaf = requestAnimationFrame(step);
      };
      edgeRaf = requestAnimationFrame(step);
    };
    const clearNavEdge = () => {
      cancelAnimationFrame(edgeRaf);
      esvg.style.transition = 'opacity .35s ease'; esvg.style.opacity = '0';
      clearTimeout(edgeClear);
      edgeClear = window.setTimeout(() => { esvg.innerHTML = ''; }, 380);
    };
    const navEnter = (key: string, btn: HTMLElement) => {
      drawNavEdge(key, btn);
      clearTimeout(navClear);
      const set = new Set(NAV_BRAIN[key] || []);
      ambientBrains.forEach((b) => { b.setHighlight?.(set); b.setThinking?.(true); });
    };
    const navLeave = () => {
      clearNavEdge();
      ambientBrains.forEach((b) => b.setThinking?.(false));
      clearTimeout(navClear);
      navClear = window.setTimeout(() => ambientBrains.forEach((b) => b.setHighlight?.(new Set())), 1100);
    };
    // Hover-only: on touch devices a tap fires mouseenter without a matching
    // mouseleave, leaving highlights/thinking stuck on the ambient brains.
    if (window.matchMedia('(hover: hover)').matches) {
      document.querySelectorAll<HTMLElement>('[data-nav]').forEach((el) => {
        const key = el.dataset.nav!;
        el.addEventListener('mouseenter', () => navEnter(key, el));
        el.addEventListener('mouseleave', navLeave);
      });
    }

    // ── chat mock ──
    const log = document.querySelector('[data-chat-log]') as HTMLElement | null;
    const hint = document.querySelector('[data-chat-hint]') as HTMLElement | null;
    let streaming = false; let tw = 0; let litClear = 0;
    const bubble = (user: boolean) => {
      const wrap = document.createElement('div');
      wrap.style.cssText = `display:flex;justify-content:${user ? 'flex-end' : 'flex-start'}`;
      const b = document.createElement('div');
      b.style.cssText =
        `max-width:86%;padding:11px 15px;border-radius:${user ? '14px 14px 4px 14px' : '14px 14px 14px 4px'};` +
        `font-size:16px;line-height:1.55;background:${user ? 'var(--card-2)' : 'transparent'};` +
        `border:1px solid ${user ? 'var(--line-2)' : 'var(--line)'};color:var(--ink);`;
      wrap.appendChild(b);
      log?.appendChild(wrap);
      return b;
    };
    const ask = (i: number) => {
      if (streaming || !log) return;
      const p = PRESETS[i];
      if (!p) return;
      hint?.remove();
      bubble(true).textContent = p.q;
      const ai = bubble(false);
      streaming = true;
      log.scrollTop = log.scrollHeight;
      if (controlsBrain) { controlsBrain.setThinking?.(true); controlsBrain.setHighlight?.(new Set(p.cites)); }
      let k = 0;
      clearInterval(tw);
      tw = window.setInterval(() => {
        k += 2;
        ai.textContent = p.a.slice(0, k);
        log.scrollTop = log.scrollHeight;
        if (k >= p.a.length) {
          clearInterval(tw);
          streaming = false;
          ai.textContent = p.a;
          const cites = document.createElement('div');
          cites.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;';
          p.citeLabels.forEach((c) => {
            const tag = document.createElement('span');
            tag.style.cssText =
              "display:inline-flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-dim);background:var(--card-2);border:1px solid var(--line-2);border-radius:7px;padding:4px 8px;";
            tag.innerHTML = '<span style="width:6px;height:6px;border-radius:50%;background:var(--detail);"></span>' + c;
            cites.appendChild(tag);
          });
          ai.appendChild(cites);
          if (controlsBrain) controlsBrain.setThinking?.(false);
          clearTimeout(litClear);
          litClear = window.setTimeout(() => controlsBrain?.setHighlight?.(new Set()), 4500);
        }
      }, 22);
    };
    document.querySelectorAll<HTMLElement>('[data-ask]').forEach((b) =>
      b.addEventListener('click', () => ask(Number(b.dataset.ask)))
    );

    // ── Floating notes: pick a note → swap the section-preview card ──
    (() => {
      const app = document.querySelector('[data-noteapp]') as HTMLElement | null;
      const stage = document.querySelector('[data-noteapp-stage]') as HTMLElement | null;
      if (!app || !stage) return;

      const notes = Array.from(app.querySelectorAll<HTMLElement>('[data-note]'));
      const cards = Array.from(stage.querySelectorAll<HTMLElement>('[data-panel]'));
      const cardFor = (id: string) => cards.find((c) => c.dataset.panel === id) || null;
      // Token per feature → recolours the soft wash behind the floating card.
      const TOK: Record<string, string> = {
        brain: 'purple', headless: 'cyan', import: 'orange',
        ai: 'accent', sticky: 'pink', private: 'red',
      };

      let current = notes.find((n) => n.classList.contains('is-active'))?.dataset.note
        || notes[0]?.dataset.note || '';

      const paintWash = (id: string) =>
        stage.style.setProperty('--stage-ac', `var(--nf-${TOK[id] || 'accent'})`);

      const select = (id: string) => {
        if (!id || id === current) return;
        current = id;
        notes.forEach((n) => {
          const on = n.dataset.note === id;
          n.classList.toggle('is-active', on);
          n.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        cards.forEach((c) => {
          const active = c.dataset.panel === id;
          c.classList.toggle('is-active', active);
          c.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        paintWash(id);
      };

      notes.forEach((n) => {
        const id = n.dataset.note!;
        n.addEventListener('click', () => select(id));
        // Keyboard: ↑/↓ to walk the list like the real sidebar.
        n.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
          e.preventDefault();
          const i = notes.indexOf(n);
          const next = notes[(i + (e.key === 'ArrowDown' ? 1 : notes.length - 1)) % notes.length];
          next.focus();
          select(next.dataset.note!);
        });
      });

      // Seed the wash for whichever note starts active.
      if (cardFor(current)) paintWash(current);
    })();

    // ── scroll reveals ──
    const reveals = Array.from(document.querySelectorAll('[data-reveal]')) as HTMLElement[];
    const show = (el: HTMLElement) => { el.style.animation = 'riseIn .8s cubic-bezier(.2,.7,.2,1) both'; };
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((ents) => {
        ents.forEach((e) => { if (e.isIntersecting) { show(e.target as HTMLElement); io.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
      reveals.forEach((el) => io.observe(el));
      setTimeout(() => reveals.forEach(show), 2600); // safety
    } else {
      reveals.forEach((el) => (el.style.opacity = '1'));
    }

    // ── #get: upgrade the download buttons to the newest release's assets ──
    // Nothing about the release is baked at build time: asset names carry the version, and Pages
    // only redeploys on `docs/**` changes, so any baked number/URL would go stale on the next
    // release. Instead the buttons ship pointing at the *page* of the latest release — always
    // valid, and what the user gets without JS or with the API down (offline, 403 rate limit).
    // Here we ask the API (it already excludes prereleases) and, when the asset is there, swap in
    // its exact `browser_download_url` (read from the API, never rebuilt from a name pattern).
    // A direct binary shouldn't open a blank tab, so `target` goes away with the rewrite.
    // Missing asset → that button is left alone on /releases/latest, still a correct landing spot.
    (async () => {
      const win = document.querySelector<HTMLAnchorElement>('[data-dl="win"]');
      const linux = document.querySelector<HTMLAnchorElement>('[data-dl="linux"]');
      if (!win && !linux) return;
      try {
        const res = await fetch('https://api.github.com/repos/yagoid/noteflow/releases/latest');
        if (!res.ok) return;
        const rel = (await res.json()) as {
          tag_name?: string;
          assets?: { name?: string; browser_download_url?: string }[];
        };
        const assets = rel.assets || [];
        const urlFor = (re: RegExp) =>
          assets.find((a) => re.test(a.name || ''))?.browser_download_url;
        // `$`-anchored so the `.blockmap` siblings never match.
        const toAsset = (a: HTMLAnchorElement | null, re: RegExp) => {
          const url = a && urlFor(re);
          if (!a || !url) return;
          a.href = url;
          a.removeAttribute('target');
        };

        toAsset(win, /-Setup\.exe$/);
        toAsset(linux, /_amd64\.deb$/);

        // Progressive enhancement: the version only shows once we know it for real.
        const label = document.querySelector<HTMLElement>('[data-dl-version]');
        const row = document.querySelector<HTMLElement>('[data-dl-version-row]');
        if (label && row && rel.tag_name) {
          label.textContent = rel.tag_name;
          row.style.visibility = 'visible';
        }
      } catch {
        /* keep the /releases/latest links */
      }
    })();
  </script>
</Base>
