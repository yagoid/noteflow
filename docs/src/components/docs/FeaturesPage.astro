  .nf-crypt.is-locked .nf-crypt-foot { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .nf-crypt-plain, .nf-crypt-cipher, .nf-crypt-foot, .nf-crypt-shackle, .nf-crypt-btn { transition: none; }
  }

  /* Hide-from-AI mock: section cells with a stem down into the AI box; the hidden one is cut */
  .nf-hide { margin: 24px 0 0; max-width: 380px; }
  .nf-hide-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .nf-hide-col { display: flex; flex-direction: column; align-items: center; }
  .nf-hide-cell {
