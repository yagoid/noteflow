---
// The /features docs page (both locales render through this component — see
// src/pages/features.astro and src/pages/es/features.astro). Layout + shell
// behaviour come from DocsShell; all prose lives in src/i18n/docs/features.{en,es}.ts.
// Structural, non-translatable data (colour tokens for the hierarchy mock, the
// theme swatch palette pulled from src/lib/themes.ts) lives here.
import DocsShell from '../../layouts/DocsShell.astro';
import StickyMock from './StickyMock.astro';
import { getFeaturesContent } from '../../i18n/docs/features';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getFeaturesContent(lang);

// Cross-page links (locale-aware). Dict strings carry %AI_URL% / %CLI_URL%
// placeholders so the prose stays plain data.
const aiUrl = getRelativeLocaleUrl(lang, '/ai');
const cliUrl = getRelativeLocaleUrl(lang, '/cli');
const organizeWhy = t.organize.whyP.replace('%AI_URL%', `${aiUrl}#embeddings`);
const fillPrivacy = (s: string) =>
  s.replace(/%AI_URL%/g, `${aiUrl}#privacy`).replace(/%CLI_URL%/g, cliUrl);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: t.meta.title,
  description: t.meta.description,
  inLanguage: lang,
  about: { '@type': 'SoftwareApplication', name: 'NoteFlow', applicationCategory: 'ProductivityApplication' },
};

// Mono section kicker: "01 / organize", numbered from the TOC order.
const kickerFor = (id: string) => {
  const i = t.toc.findIndex((item) => item.id === id);
  return `${String(i + 1).padStart(2, '0')} / ${id.replace(/-/g, ' ')}`;
};

// Hierarchy mock: colour tokens are structural (names come from the dictionary).
// Each note draws its sections like the app's sidebar: a closed note is a folded
// line (one stretch per section, as wide as the section is long — `secWeight`), the
// open one (`isOpen`: the first note of the first folder) is the unfolded map of
// cells with its open section solid. Hovering a closed note floats its map over it.
const groupToks = ['cyan', 'orange'];
const tagToks = ['purple', 'accent', 'pink', 'cyan', 'orange'];
const tagTok = (noteIdx: number, secIdx: number) => tagToks[(noteIdx + secIdx) % tagToks.length];
const secWeights = [5, 3, 4, 2, 6];
const secWeight = (noteIdx: number, secIdx: number) => secWeights[(noteIdx * 2 + secIdx) % secWeights.length];

interface TreeNote { title: string; open: boolean; secs: { name: string; tok: string; weight: number }[] }
interface TreeRow { folder: string | null; notes: TreeNote[] }
interface TreeCol { name: string; gc: string | null; rows: TreeRow[] }
const treeNote = (n: { title: string; sections: string[] }, colorIdx: number, open = false): TreeNote => ({
  title: n.title,
  open,
  secs: n.sections.map((name, si) => ({ name, tok: tagTok(colorIdx, si), weight: secWeight(colorIdx, si) })),
});
const treeCols: TreeCol[] = [
  ...t.organize.tree.groups.map((g, gi) => ({
    name: g.name,
    gc: groupToks[gi % groupToks.length],
    rows: [
      ...g.folders.map((f, fi) => ({
        folder: f.name,
        notes: f.notes.map((n, ni) => treeNote(n, ni, gi === 0 && fi === 0 && ni === 0)),
      })),
      { folder: null, notes: g.notes.map((n, ni) => treeNote(n, ni + 2)) },
    ],
  })),
  {
    name: t.organize.tree.ungroupedLabel,
    gc: null,
    rows: [{ folder: null, notes: t.organize.tree.ungroupedNotes.map((n, ni) => treeNote(n, ni + 4)) }],
  },
];

// Theme swatches — palette values verbatim from src/lib/themes.ts (--bg-0 / --text / --accent).
const themeSwatches = {
  dark: [
    { name: 'NoteFlow Dark', bg: '12 12 17', ink: '236 234 224', ac: '245 166 35' },
    { name: 'Midnight Blue', bg: '9 12 17', ink: '212 212 212', ac: '78 158 255' },
    { name: 'Carbon', bg: '9 9 9', ink: '212 212 212', ac: '78 158 255' },
    { name: 'Tokyo Night', bg: '19 20 30', ink: '192 202 245', ac: '122 162 247' },
    { name: 'VS Code Dark', bg: '38 38 40', ink: '212 212 212', ac: '86 156 214' },
    { name: 'Dracula', bg: '30 31 41', ink: '248 248 242', ac: '189 147 249' },
    { name: 'True Godot', bg: '26 26 26', ink: '224 224 224', ac: '71 140 191' },
    { name: 'GruvBox Dark', bg: '29 28 26', ink: '235 219 178', ac: '69 133 136' },
    { name: 'Obsidian', bg: '12 12 12', ink: '224 224 224', ac: '180 180 180' },
    { name: 'Emerald Forest', bg: '10 20 14', ink: '210 230 215', ac: '100 200 130' },
    { name: 'Synthwave', bg: '15 10 25', ink: '235 220 245', ac: '255 100 200' },
  ],
  light: [
    { name: 'NoteFlow Light', bg: '231 223 204', ink: '42 38 32', ac: '184 117 20' },
    { name: 'Arctic Day', bg: '220 230 242', ink: '26 38 64', ac: '26 111 204' },
    { name: 'Parchment', bg: '220 220 218', ink: '42 38 32', ac: '75 118 188' },
  ],
};
---

<DocsShell
  lang={lang}
  page="features"
  accent="orange"
  title={t.meta.title}
  description={t.meta.description}
  kicker={t.hero.kicker}
  h1={t.hero.h1}
  tagline={t.hero.tagline}
  toc={t.toc}
  jsonLd={jsonLd}
>
  <!-- ── Organize ── -->
  <section id="organize" data-reveal>
    <div class="nf-sec-head">{kickerFor('organize')}</div>
    <h2>{t.organize.title}</h2>
    {t.organize.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}

    <!-- Hierarchy mock: colour-coded groups → folders → notes → their sections (folded map) -->
    <figure class="nf-tree nf-edge" role="img" aria-label={t.organize.tree.aria}>
      <div class="nf-tree-cols">
        {treeCols.map((col) => (
          <div class={`nf-tree-group${col.gc ? '' : ' is-ungrouped'}`} style={col.gc ? `--gc:var(--${col.gc});` : undefined}>
            <div class="nf-tree-ghead">{col.gc && <span class="nf-tree-gdot" aria-hidden="true"></span>}{col.name}</div>
            <div class="nf-tree-gbody">
              {col.rows.map((r) => (
                <div class={r.folder !== null ? 'nf-tree-folder' : 'nf-tree-loose'}>
                  {r.folder !== null && (
                    <div class="nf-tree-fhead">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                      {r.folder}
                    </div>
                  )}
                  <div class="nf-tree-notes">
                    {r.notes.map((n) => (
                      <div class={`nf-tree-note${n.open ? ' is-open' : ''}`}>
                        <span class="nf-tree-ntitle">{n.title}</span>
                        {!n.open && (
                          <span class="nf-tree-line" aria-hidden="true">
                            {n.secs.map((s) => <span class="nf-tree-seg" style={`--tc:var(--${s.tok});flex-grow:${s.weight};`}></span>)}
                          </span>
                        )}
                        <span class="nf-tree-map">
                          {n.secs.map((s, si) => <span class={`nf-tree-cell${n.open && si === 0 ? ' is-active' : ''}`} style={`--tc:var(--${s.tok});`}>{s.name}</span>)}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <figcaption class="nf-tree-caption">{t.organize.tree.caption}</figcaption>
    </figure>

    <h3>{t.organize.sectionsH3}</h3>
    {t.organize.sectionsP.map((p) => <p class="nf-docs-p" set:html={p} />)}
    <p class="nf-docs-p" set:html={organizeWhy} />
  </section>

  <!-- ── Templates ── -->
  <section id="templates" data-reveal>
    <div class="nf-sec-head">{kickerFor('templates')}</div>
    <h2>{t.templates.title}</h2>
    {t.templates.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}
    <ol class="nf-feat-steps">
      {t.templates.steps.map((s, i) => (
        <li class="nf-feat-step">
          <span class="nf-feat-step-num">{String(i + 1).padStart(2, '0')}</span>
          <div class="nf-feat-step-body">
            <h3>{s.title}</h3>
            <p set:html={s.desc} />
          </div>
        </li>
      ))}
    </ol>
    <p class="nf-docs-p" set:html={t.templates.syncP} />
  </section>

  <!-- ── Sticky notes ── -->
  <section id="sticky" data-reveal>
    <div class="nf-sec-head">{kickerFor('sticky')}</div>
    <h2>{t.sticky.title}</h2>
    {t.sticky.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}

    <StickyMock
      winTitle={t.sticky.mock.winTitle}
      items={t.sticky.mock.items}
      caption={t.sticky.mock.caption}
      foldAria={t.sticky.mock.foldAria}
      closeAria={t.sticky.mock.closeAria}
      switchHint={t.sticky.mock.switchHint}
    />

    <ul class="nf-docs-ul">
      {t.sticky.bullets.map((b) => <li set:html={b} />)}
    </ul>
    <h3>{t.sticky.startupH3}</h3>
    <p class="nf-docs-p" set:html={t.sticky.startupP} />
  </section>

  <!-- ── Section links ── -->
  <section id="links" data-reveal>
    <div class="nf-sec-head">{kickerFor('links')}</div>
    <h2>{t.links.title}</h2>
    {t.links.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}

    <!-- Pill mock: a live pill in flowing text, a broken one, and the raw form -->
    <div class="nf-linkmock nf-edge">
      <p class="nf-linkmock-line">
        {t.links.mock.before}<span class="nf-pill"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>{t.links.mock.pill}</span>{t.links.mock.after}
      </p>
      <p class="nf-linkmock-line is-note">
        {t.links.mock.brokenLabel}
        <span class="nf-pill is-broken"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>{t.links.mock.brokenPill}</span>
      </p>
      <div class="nf-linkmock-raw">
        <span class="nf-linkmock-rawlabel">{t.links.mock.rawLabel}</span>
        <code>{t.links.mock.raw}</code>
      </div>
    </div>

    <ul class="nf-docs-ul">
      {t.links.bullets.map((b) => <li set:html={b} />)}
    </ul>
    <p class="nf-docs-p" set:html={t.links.rawP} />
    <p class="nf-docs-p" set:html={t.links.brainP} />
  </section>

  <!-- ── Snippets ── -->
  <section id="snippets" data-reveal>
    <div class="nf-sec-head">{kickerFor('snippets')}</div>
    <h2>{t.snippets.title}</h2>
    {t.snippets.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}

    <!-- Snippet mock: the stored markdown with its variables → what lands in the note
         (the source starts with `## `, so the output is drawn as a rendered heading) -->
    <div class="nf-snipmock nf-edge">
      <div class="nf-snipmock-row">
        <span class="nf-snipmock-label">{t.snippets.mock.sourceLabel}</span>
        <code>{t.snippets.mock.source}</code>
      </div>
      <div class="nf-snipmock-row is-output">
        <span class="nf-snipmock-label">{t.snippets.mock.outputLabel}</span>
        <span class="nf-snipmock-out">{t.snippets.mock.output}</span>
      </div>
    </div>

    <ul class="nf-docs-ul">
      {t.snippets.bullets.map((b) => <li set:html={b} />)}
    </ul>
    <p class="nf-docs-p" set:html={t.snippets.syncP} />
  </section>

  <!-- ── Shortcuts ── -->
  <section id="shortcuts" data-reveal>
    <div class="nf-sec-head">{kickerFor('shortcuts')}</div>
    <h2>{t.shortcuts.title}</h2>
    {t.shortcuts.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}
    <aside class="nf-feat-callout"><p set:html={t.shortcuts.macNote} /></aside>

    {t.shortcuts.groups.map((g) => (
      <div class="nf-keys-group">
        <h3 class="nf-keys-label"><span class="nf-keys-dot" aria-hidden="true"></span>{g.label}</h3>
        <table class="nf-ref-table nf-keys-table">
          <thead><tr><th>{t.shortcuts.colShortcut}</th><th>{t.shortcuts.colAction}</th></tr></thead>
          <tbody>
            {g.rows.map((r) => (
              <tr>
                <td class="nf-keys-combo">
                  {r.combos.map((combo, ci) => (
                    <>
                      {ci > 0 && <span class="nf-keys-sep">/</span>}
                      <span class="nf-keys-kbds">{combo.map((k, ki) => (<>{ki > 0 && <span class="nf-keys-plus">+</span>}<kbd>{k}</kbd></>))}</span>
                    </>
                  ))}
                </td>
                <td>{r.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </section>

  <!-- ── Views ── -->
  <section id="views" data-reveal>
    <div class="nf-sec-head">{kickerFor('views')}</div>
    <h2>{t.views.title}</h2>
    {t.views.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}
    <div class="nf-view-grid">
      {t.views.cards.map((c) => (
        <article class="nf-view-card nf-edge">
          <div class="nf-view-tag">{c.tag}</div>
          <h3>{c.name}</h3>
          <p set:html={c.desc} />
        </article>
      ))}
    </div>
  </section>

  <!-- ── Temporary notes ── -->
  <section id="temp" data-reveal>
    <div class="nf-sec-head">{kickerFor('temp')}</div>
    <h2>{t.temp.title}</h2>
    {t.temp.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}
    <ul class="nf-docs-ul">
      {t.temp.bullets.map((b) => <li set:html={b} />)}
    </ul>
  </section>

  <!-- ── Encryption ── -->
  <section id="encryption" data-reveal>
    <div class="nf-sec-head">{kickerFor('encryption')}</div>
    <h2>{t.encryption.title}</h2>
    {t.encryption.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}
    <ul class="nf-docs-ul">
      {t.encryption.bullets.map((b) => <li set:html={fillPrivacy(b)} />)}
    </ul>
  </section>

  <!-- ── Hide from AI ── -->
  <section id="ai-hidden" data-reveal>
    <div class="nf-sec-head">{kickerFor('ai-hidden')}</div>
    <h2>{t.aiHidden.title}</h2>
    {t.aiHidden.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}
    <ul class="nf-docs-ul">
      {t.aiHidden.bullets.map((b) => <li set:html={b} />)}
    </ul>
    <p class="nf-docs-p" set:html={fillPrivacy(t.aiHidden.moreP)} />
  </section>

  <!-- ── Personalize ── -->
  <section id="personalize" data-reveal>
    <div class="nf-sec-head">{kickerFor('personalize')}</div>
    <h2>{t.personalize.title}</h2>
    {t.personalize.intro.map((p) => <p class="nf-docs-p" set:html={p} />)}

    <div class="nf-swatch-rows">
      {(['dark', 'light'] as const).map((mode) => (
        <div class="nf-swatch-row">
          <span class="nf-swatch-rowlabel">{mode === 'dark' ? t.personalize.darkLabel : t.personalize.lightLabel}</span>
          <div class="nf-swatches">
            {themeSwatches[mode].map((s) => (
              <figure class="nf-swatch">
                <div class="nf-swatch-tile" style={`--sb:${s.bg};--si:${s.ink};--sa:${s.ac};`}>
                  <span class="nf-swatch-dot" aria-hidden="true"></span>
                  <span class="nf-swatch-bar" aria-hidden="true"></span>
                  <span class="nf-swatch-bar is-short" aria-hidden="true"></span>
                </div>
                <figcaption>{s.name}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="nf-docs-p" set:html={t.personalize.moreP} />
    <p class="nf-docs-p" set:html={t.personalize.widthP} />
  </section>
</DocsShell>

<style is:global>
  /* ── /features page-specific styles (shared widgets live in docs.css). Accent = orange. ── */

  /* Hierarchy mock: groups → folders → notes → sections (folded line / map) */
  .nf-tree {
    margin: 24px 0 26px;
    padding: 20px 22px 15px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--card);
  }
  .nf-tree-cols {
    display: flex;
    flex-wrap: wrap;
    gap: 22px 34px;
  }
  .nf-tree-group { flex: 1 1 240px; min-width: 220px; max-width: 330px; }
  .nf-tree-ghead {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgb(var(--gc, 128 128 128));
  }
  .nf-tree-group.is-ungrouped .nf-tree-ghead { color: var(--ink-faint); }
  .nf-tree-gdot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(var(--gc));
    box-shadow: 0 0 10px rgb(var(--gc) / .65);
  }
  /* Guides: a fine line in the group colour runs down the whole group, and each
     folder has its own under its icon (like the app's "index with guides"). */
  .nf-tree-gbody { margin-left: 4px; padding-left: 12px; border-left: 1px solid rgb(var(--gc) / .35); }
  .nf-tree-group.is-ungrouped .nf-tree-gbody { border-left-color: transparent; }
  .nf-tree-folder { margin: 0 0 8px; }
  .nf-tree-fhead {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 4px 0 6px;
    font-size: 13px;
    font-weight: 500;
    color: rgb(var(--gc) / .9);
  }
  .nf-tree-folder .nf-tree-notes { margin-left: 5px; padding-left: 12px; border-left: 1px solid rgb(var(--gc) / .35); }
  .nf-tree-note {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 5px 0;
  }
  /* The open note: a marker in the group colour sitting on its guide */
  .nf-tree-note.is-open::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 6px;
    bottom: 6px;
    width: 3px;
    border-radius: 2px;
    background: rgb(var(--gc));
  }
  .nf-tree-ntitle { font-size: 14px; color: var(--ink); }
  .nf-tree-note.is-open .nf-tree-ntitle { color: var(--ink-strong); }
  /* Closed note → folded line: one stretch per section, as wide as the section is long */
  .nf-tree-line { display: flex; gap: 2px; height: 3px; max-width: 220px; }
  .nf-tree-seg { flex: 1 1 0; min-width: 4px; border-radius: 2px; background: rgb(var(--tc) / .75); transition: background .18s ease; }
  .nf-tree-note:hover .nf-tree-seg { background: rgb(var(--tc)); }
  /* Unfolded map: neutral cells with a folded corner in the section colour, the open one solid */
  .nf-tree-map {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5px;
    max-width: 260px;
    border-radius: 5px;
    overflow: hidden;
  }
  .nf-tree-cell {
    position: relative;
    flex: 1 1 auto;
    padding: 2px 13px 2px 7px;
    font-size: 10.5px;
    line-height: 1.5;
    white-space: nowrap;
    color: var(--ink-dim);
    background: var(--card-2);
  }
  .nf-tree-cell::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    border-style: solid;
    border-width: 0 7px 7px 0;
    border-color: transparent rgb(var(--tc)) transparent transparent;
  }
  .nf-tree-cell.is-active { font-weight: 600; color: var(--bg); background: rgb(var(--tc)); }
  .nf-tree-cell.is-active::after { display: none; }
  [data-theme='light'] .nf-tree-cell.is-active { color: var(--ink-strong); }
  /* Closed notes float their map over the list when the mouse rests on them */
  .nf-tree-note:not(.is-open) .nf-tree-map {
    position: absolute;
    left: -6px;
    top: calc(100% - 9px);
    z-index: 2;
    padding: 5px 6px;
    border: 1px solid var(--line-2);
    border-radius: 7px;
    background: var(--card);
    box-shadow: 0 10px 24px rgba(0, 0, 0, .28);
    opacity: 0;
    visibility: hidden;
    transition: opacity .15s ease, visibility 0s linear .15s;
  }
  .nf-tree-note:not(.is-open):hover .nf-tree-map {
    opacity: 1;
    visibility: visible;
    transition: opacity .15s ease .15s, visibility 0s linear .15s;
  }
  [data-theme='light'] .nf-tree-note:not(.is-open) .nf-tree-map { box-shadow: 0 10px 24px rgba(40, 34, 24, .16); }
  @media (prefers-reduced-motion: reduce) {
    .nf-tree-note:not(.is-open) .nf-tree-map,
    .nf-tree-note:not(.is-open):hover .nf-tree-map { transition: none; }
  }
  .nf-tree-caption {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* Numbered steps (templates) — same language as the RAG steps on /ai */
  .nf-feat-steps { margin: 18px 0 8px; padding: 0; list-style: none; max-width: 72ch; }
  .nf-feat-step { display: flex; gap: 18px; padding: 15px 0; border-bottom: 1px solid var(--line); }
  .nf-feat-step:last-child { border-bottom: 0; }
  .nf-feat-step-num {
    flex: 0 0 auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
