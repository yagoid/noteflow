<script>
  // Encryption mock: the lock button toggles the demo note; the first time it scrolls
  // into view it locks itself once (its text wipes into ciphertext). The markup ships
  // locked (the no-JS state); with motion allowed it starts unlocked so the wipe shows.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-crypt]').forEach((fig) => {
    const btn = fig.querySelector<HTMLButtonElement>('[data-crypt-toggle]');
    if (!btn) return;
    let touched = false;
    const setLocked = (on: boolean) => {
      fig.classList.toggle('is-locked', on);
      btn.setAttribute('aria-label', (on ? btn.dataset.labelUnlock : btn.dataset.labelLock) || '');
    };
    btn.addEventListener('click', () => {
      touched = true;
      setLocked(!fig.classList.contains('is-locked'));
    });
    btn.hidden = false;
    if (reduceMotion || !('IntersectionObserver' in window)) return;
    setLocked(false);
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      setTimeout(() => { if (!touched) setLocked(true); }, 900);
    }, { threshold: 0.6 });
    io.observe(fig);
  });
</script>
