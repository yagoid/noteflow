  [data-theme='light'] .nf-crypt-cipher { color: var(--detail); }
  .nf-crypt.is-locked .nf-crypt-plain { clip-path: inset(0 0 0 100%); }
  .nf-crypt.is-locked .nf-crypt-cipher { clip-path: inset(0 0 0 0); }
  .nf-crypt-foot {
