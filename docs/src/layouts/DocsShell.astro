---
// Shared shell for the long-form docs pages (/cli, /ai, /features, /pricing) and the
// legal pages (/privacy, /terms, /legal-notice): wraps Base with the neural background, a docs
// variant of the vertical rail, the page header (kicker + h1 + tagline), the
// content+TOC grid and a slim footer. Page-specific markup goes in the default
// slot as <section id="…"> blocks matching `toc`.
// The legal pages are "off-rail": the rail keeps its four fixed neurons (none is
// active on them) and they are only linked from the footers.
import '../styles/docs.css';
import Base from './Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getDocsCommon } from '../i18n/docs/common';
import { legalNoticeReady } from '../i18n/docs/legal-notice.owner';
import type { Lang } from '../i18n';

type DocsPage = 'cli' | 'ai' | 'features' | 'pricing' | 'privacy' | 'terms' | 'legal-notice';

interface TocItem {
  id: string;
  label: string;
}

interface Props {
  lang: Lang;
  page: DocsPage;
  title: string;
  description: string;
  kicker: string;
  h1: string;
  tagline: string;
  toc: TocItem[];
  accent: 'cyan' | 'purple' | 'orange' | 'pink';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { lang, page, title, description, kicker, h1, tagline, toc, accent, jsonLd } = Astro.props;
const c = getDocsCommon(lang);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';

// The docs pages, each tied to its rail accent. The language switch lands on
// the MIRROR of the same page (not the home).
const railPages = [
  { key: 'cli' as const, tok: 'cyan', label: c.rail.cli },
  { key: 'ai' as const, tok: 'purple', label: c.rail.ai },
  { key: 'features' as const, tok: 'orange', label: c.rail.features },
  { key: 'pricing' as const, tok: 'pink', label: c.rail.pricing },
];
const homeHref = getRelativeLocaleUrl(lang, '/');
const switchHref = getRelativeLocaleUrl(otherLang, `/${page}`);
// "Cookies" link (reopens the consent banner). Falls back to /privacy without JS.
const cookieHref = getRelativeLocaleUrl(lang, '/privacy');
const GITHUB = 'https://github.com/yagoid/noteflow';

// The legal pages: footer-only links (no rail neuron). The legal notice is only linked
// once its owner data is filled in (otherwise the page is not generated).
const legalPages = [
  { key: 'privacy' as const, label: c.footer.privacy },
  { key: 'terms' as const, label: c.footer.terms },
  ...(legalNoticeReady ? [{ key: 'legal-notice' as const, label: c.footer.legalNotice }] : []),
];
const footerLinks = [
  { href: homeHref, label: c.footer.home },
  ...railPages
    .filter((p) => p.key !== page)
    .map((p) => ({ href: getRelativeLocaleUrl(lang, `/${p.key}`), label: c.footer[p.key] })),
  ...legalPages
    .filter((p) => p.key !== page)
    .map((p) => ({ href: getRelativeLocaleUrl(lang, `/${p.key}`), label: p.label })),
];

// Mono label style shared with the landing (Home.astro).
const label =
  "font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--ink-faint);";
const railLabel =
  "font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);";
---

<Base lang={lang} path={`/${page}`} title={title} description={description} jsonLd={jsonLd}>
  <div data-root style={`position:relative;width:100%;background:var(--bg);--page-accent:rgb(var(--${accent}));`}>
    <nf-netbg style="position:fixed;inset:0;z-index:0;pointer-events:none;"></nf-netbg>

    <!-- Vertical neuron rail (docs variant: home on top, the docs pages in the middle) -->
    <nav
      class="nf-rail"
      data-labels
      style="position:fixed;top:0;left:0;bottom:0;z-index:60;width:80px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:26px 0;background:var(--nav-bg, transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);"
    >
      <a href={homeHref} class="nf-neuron" style="--c:var(--ink-strong);display:flex;align-items:center;justify-content:center;width:100%;height:52px;color:var(--c);">
        <svg class="nf-soma" width="26" height="26" viewBox="-13 -13 26 26" fill="none" stroke="currentColor" stroke-linecap="round">
          <circle cx="0" cy="0" r="7" stroke-width="1.4" opacity=".5"></circle>
          <circle class="nf-fill" cx="0" cy="0" r="3" fill="currentColor" stroke="none" opacity=".45"></circle>
        </svg>
        <span class="nf-label" style={railLabel}><b style="font-weight:600;letter-spacing:.04em;">NoteFlow</b> · {c.rail.home}</span>
      </a>

      <div style="display:flex;flex-direction:column;align-items:center;gap:30px;">
        {railPages.map((p) => (
          <a
            href={getRelativeLocaleUrl(lang, `/${p.key}`)}
            aria-current={p.key === page ? 'page' : undefined}
            class="nf-neuron"
            style={`--c:rgb(var(--${p.tok}));display:flex;align-items:center;justify-content:center;width:100%;height:34px;color:var(--c);`}
          >
            <svg class="nf-soma" width="26" height="26" viewBox="-13 -13 26 26" fill="none" stroke="currentColor" stroke-linecap="round">
              <circle cx="0" cy="0" r="7" stroke-width="1.4" opacity=".5"></circle>
              <circle class="nf-fill" cx="0" cy="0" r="3" fill="currentColor" stroke="none" opacity={p.key === page ? '.95' : '.3'}></circle>
            </svg>
            <span class="nf-label" style={railLabel}>{p.label}</span>
          </a>
        ))}
      </div>

      <div style="display:flex;flex-direction:column;align-items:center;gap:22px;">
        <a href={switchHref} class="nf-neuron nf-lang-btn" aria-label={c.langSwitch.aria} style="--c:var(--ink-dim);display:grid;place-items:center;width:36px;height:36px;border-radius:8px;border:1px solid var(--line-2);background:transparent;color:var(--ink);text-decoration:none;font-size:12px;font-weight:600;letter-spacing:.04em;font-family:'JetBrains Mono',monospace;">{c.langSwitch.label}</a>
        <button data-theme-toggle aria-label={c.rail.toggleTheme} class="nf-neuron nf-theme-btn" style="--c:var(--ink-dim);display:grid;place-items:center;width:36px;height:36px;border-radius:8px;border:1px solid var(--line-2);background:transparent;color:var(--ink);cursor:pointer;font-size:14px;font-family:'JetBrains Mono',monospace;">
          <span class="nf-theme-icon">☀</span>
        </button>
      </div>
    </nav>

    <!-- Page header -->
    <header style="position:relative;z-index:2;max-width:1240px;margin:0 auto;padding:clamp(96px,14vh,150px) clamp(22px,5vw,64px) clamp(38px,5vw,58px);">
      <div style={`display:flex;align-items:center;gap:13px;${label}animation:riseIn .8s .05s both;`}>
        <span style="width:22px;height:1px;background:var(--page-accent);display:inline-block;"></span>{kicker}
      </div>
      <h1 style="margin:24px 0 0;font-size:clamp(44px,6.5vw,92px);line-height:.98;letter-spacing:-.02em;font-weight:500;color:var(--ink-strong);animation:riseIn .9s .12s both;" set:html={h1}></h1>
      <span style="display:block;width:76px;height:3px;margin-top:22px;background:var(--page-accent);border-radius:2px;animation:riseIn .9s .2s both;"></span>
      <p style="margin:24px 0 0;max-width:640px;font-style:italic;font-size:clamp(19px,1.6vw,25px);line-height:1.45;color:var(--ink-faint);animation:riseIn .9s .3s both;">{tagline}</p>
    </header>

    <!-- Content + TOC -->
    <div class="nf-docs-wrap nf-docs-grid">
      <aside class="nf-docs-toc" aria-label={c.onThisPage}>
        <span class="nf-toc-label">{c.onThisPage}</span>
        <ul class="nf-toc-list">
          {toc.map((item) => (
            <li><a class="nf-toc-link" href={`#${item.id}`}>{item.label}</a></li>
          ))}
        </ul>
      </aside>
      <main class="nf-docs-content"><slot /></main>
    </div>

    <!-- Slim footer (mirrors the bottom row of the landing footer) -->
    <footer style="position:relative;z-index:2;border-top:1px solid var(--line);">
      <div style="max-width:1240px;margin:0 auto;padding:26px clamp(22px,5vw,64px) 34px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-faint);">
        <div style="display:flex;align-items:center;gap:10px;color:var(--ink-dim);"><span style="width:9px;height:9px;border-radius:50%;background:var(--page-accent);"></span>{c.footer.brand}</div>
        <div style="display:flex;gap:22px;flex-wrap:wrap;">
          {footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={cookieHref} data-cookie-settings>{c.footer.cookies}</a>
          <a href={GITHUB} target="_blank" rel="noopener">{c.footer.source}</a>
          <a href={switchHref} aria-label={c.langSwitch.aria}>{c.langSwitch.label}</a>
        </div>
        <div>{c.footer.copyright}</div>
      </div>
    </footer>
  </div>

  <!-- Copy-button labels for the client script (bundled scripts can't read props). -->
  <script is:inline type="application/json" data-nf-copy-i18n set:html={JSON.stringify(c.copy)} />

  <script>
    // ── theme toggle (same behaviour as the landing; nf-netbg recolours itself
    //    via a MutationObserver on data-theme, so no extra kick is needed) ──
    const THEME_KEY = 'noteflow:web-theme';
    const root = document.documentElement;
    const themeIcons = Array.from(document.querySelectorAll('.nf-theme-icon'));
    const syncThemeIcon = () => {
      const dark = root.getAttribute('data-theme') !== 'light';
      themeIcons.forEach((el) => (el.textContent = dark ? '☀' : '☾'));
    };
    syncThemeIcon();
    document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
      b.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem(THEME_KEY, next); } catch { /* private mode */ }
        syncThemeIcon();
      }),
    );

    // ── scroll reveals ──
    const reveals = Array.from(document.querySelectorAll('[data-reveal]')) as HTMLElement[];
    const show = (el: HTMLElement) => { el.style.animation = 'riseIn .8s cubic-bezier(.2,.7,.2,1) both'; };
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((ents) => {
        ents.forEach((e) => { if (e.isIntersecting) { show(e.target as HTMLElement); io.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
      reveals.forEach((el) => io.observe(el));
      setTimeout(() => reveals.forEach(show), 2600); // safety
    } else {
      reveals.forEach((el) => (el.style.opacity = '1'));
    }

    // ── TOC scroll-spy ──
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nf-toc-link'));
    const linkFor = new Map(tocLinks.map((a) => [(a.getAttribute('href') || '').slice(1), a]));
    const setActive = (id: string) => {
      tocLinks.forEach((a) => a.classList.toggle('is-active', a === linkFor.get(id)));
      // Keep the active chip in view when the TOC is the horizontal mobile bar.
      const active = linkFor.get(id);
      const list = active?.closest('.nf-toc-list') as HTMLElement | null;
      if (active && list && list.scrollWidth > list.clientWidth) {
        const li = active.parentElement as HTMLElement;
        list.scrollTo({ left: li.offsetLeft - list.clientWidth / 2 + li.clientWidth / 2, behavior: 'smooth' });
      }
    };
    const spy = new IntersectionObserver((ents) => {
      ents.forEach((e) => { if (e.isIntersecting) setActive((e.target as HTMLElement).id); });
    }, { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('.nf-docs-content section[id]').forEach((s) => spy.observe(s));

    // ── copy-to-clipboard for pre[data-copy] ──
    let copyI18n = { idle: 'copy', done: 'copied', aria: 'Copy to clipboard' };
    try {
      const el = document.querySelector('[data-nf-copy-i18n]');
      if (el?.textContent) copyI18n = JSON.parse(el.textContent);
    } catch { /* fall back to English */ }
    const copyText = (pre: HTMLElement) => {
      const explicit = pre.getAttribute('data-copy');
      if (explicit) return explicit;
      const cmds = Array.from(pre.querySelectorAll('.nf-tl-cmd .nf-tl-text'));
      if (cmds.length) return cmds.map((c) => c.textContent || '').join('\n');
      return pre.innerText;
    };
    document.querySelectorAll<HTMLElement>('pre[data-copy]').forEach((pre) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'nf-copy';
      btn.textContent = copyI18n.idle;
      btn.setAttribute('aria-label', copyI18n.aria);
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyText(pre));
          btn.textContent = copyI18n.done;
          btn.classList.add('is-done');
          setTimeout(() => { btn.textContent = copyI18n.idle; btn.classList.remove('is-done'); }, 1600);
        } catch { /* clipboard unavailable */ }
      });
      const bar = pre.closest('.nf-term')?.querySelector('.nf-term-bar');
      if (bar) bar.appendChild(btn);
      else { btn.classList.add('nf-copy-abs'); pre.style.position = 'relative'; pre.appendChild(btn); }
    });
  </script>
</Base>
